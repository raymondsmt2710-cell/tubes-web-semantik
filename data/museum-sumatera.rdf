        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/exhibit/3"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/source/1"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-bengkulu/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

