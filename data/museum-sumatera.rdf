    <!-- Instance museum -->

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-aceh">
        <rdfs:label xml:lang="id">Museum Negeri Aceh</rdfs:label>
        <sdp:description xml:lang="id">Museum tertua di Aceh yang menempati bekas gedung pameran kolonial dari awal abad ke-20. Koleksinya mencakup naskah, senjata tradisional, dan benda sehari-hari masyarakat Aceh, termasuk koleksi Rumoh Aceh di halaman belakang.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/aceh"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/banda-aceh"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/1"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/seni-budaya"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1915</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Sultan Mahmudsyah No. 12, Banda Aceh</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.5483</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">95.3238</sdp:longitude>
        <sdp:history xml:lang="id">Museum Aceh berawal dari Paviliun Aceh dalam Pameran Kolonial (De Koloniale Tentoonstelling) di Semarang pada 13 Agustus–15 November 1914. Paviliun itu memamerkan koleksi milik F.W. Stammeshaus dan benda pusaka para pembesar Aceh, lalu meraih empat medali emas, sebelas perak, tiga perunggu, serta piagam sebagai paviliun terbaik.

Atas usul Stammeshaus, paviliun dibawa kembali ke Kutaraja (kini Banda Aceh) dan diresmikan sebagai museum pada 31 Juli 1915 oleh Gubernur Sipil dan Militer Belanda di Aceh, H.N.A. Swart. Stammeshaus menjadi kurator pertamanya.

Pada 1969 museum dipindahkan ke Jalan Sultan Alaidin Mahmudsyah atas prakarsa T. Hamzah Bendahara. Statusnya berubah menjadi Museum Negeri Aceh melalui Surat Keputusan Menteri Pendidikan dan Kebudayaan pada 28 Mei 1979, dan diresmikan kembali pada 1 September 1980 oleh Menteri Daoed Yoesoef. Pengelolaannya kini berada di bawah Pemerintah Provinsi Aceh.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-aceh/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-aceh/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-aceh/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-aceh/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-aceh/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-aceh/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-aceh/exhibit/4"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-aceh/exhibit/5"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-aceh/source/1"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-aceh/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

