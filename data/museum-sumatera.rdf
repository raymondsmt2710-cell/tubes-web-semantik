    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/2/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Dari depan terlihat struktur rumah panggung dengan tiang penyangga dan ukiran pada bagian atap.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/2/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Susunan huta (kampung) sengaja dipertahankan seperti aslinya.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/2/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Tujuannya agar pengunjung memahami rumah adat sebagai bagian tata ruang kampung, bukan bangunan tunggal.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/2/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Rumah-rumah saling berhadapan membentuk ruang bersama di tengahnya.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/3">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-huta-bolon-simanindo/3.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Patung batu penjaga</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Dua patung batu berwujud sosok duduk ini diletakkan di bawah naungan atap rumbia di area museum. Patung semacam ini dalam tradisi Batak berfungsi sebagai penjaga kampung dan penanda leluhur; gayanya yang sederhana menunjukkan tradisi megalitik yang lebih tua daripada arsitektur rumah adatnya.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">tradisi megalitik</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Huta Bolon Simanindo — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Koleksi museum di Kabupaten Samosir</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Nafisathallah</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AKoleksi_Patung_Museum_Huta_Bolon_Simanindo_1.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/3/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/3/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/3/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/3/detail/4"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/3/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Dua patung batu berwujud sosok duduk ini diletakkan di bawah naungan atap rumbia.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/3/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Dalam tradisi Batak, patung semacam ini berfungsi sebagai penjaga kampung dan penanda leluhur.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/3/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Gayanya yang sederhana menunjukkan tradisi megalitik yang lebih tua daripada arsitektur rumah adatnya.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/3/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Karena itu patung batu ini memberi petunjuk bahwa kawasan ini dihuni jauh sebelum rumah panggung dibangun.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Pustaha laklak</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Pustaha laklak adalah naskah Batak berbahan kulit kayu yang memuat ilmu tradisional dan ramalan. Isinya ditulis dengan aksara Batak dan dilipat seperti akordeon, sehingga bisa dibuka panjang saat dibaca. Naskah semacam ini biasanya dipegang oleh dukun atau ahli adat, bukan bacaan umum, karena berkaitan dengan pengobatan dan penentuan hari baik. Bagi museum, pustaha menunjukkan bahwa masyarakat Batak punya tradisi tulis sendiri, bukan hanya tradisi lisan yang lebih sering diceritakan.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">tradisi tulis Batak pra-kolonial</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kawasan Danau Toba, Samosir</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kulit kayu dan tali</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Tunggal panaluan</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Tunggal panaluan adalah tongkat pusaka berukir yang dipakai dalam upacara masyarakat Batak. Ukirannya biasanya berupa sosok-sosok bertumpuk, dan tongkat ini dianggap memiliki kekuatan yang hanya bisa dipakai oleh orang tertentu. Dalam upacara, benda seperti ini berfungsi sebagai penanda otoritas sekaligus perlengkapan ritual. Karena itu tunggal panaluan termasuk benda yang paling sering dibicarakan dalam penjelasan tentang kebudayaan Batak, dan kehadirannya di museum membantu pengunjung memahami sisi spiritual masyarakat Danau Toba.</sdp:exhibitDescription>
        <sdp:exhibitOrigin xml:lang="id">Kawasan Samosir</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kayu berukir</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Solu bolon</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Solu bolon adalah perahu kayu besar khas Batak yang dipamerkan di kompleks huta. Danau Toba menjadi jalur penghubung antarkampung, sehingga perahu bukan hanya alat transportasi tetapi juga bagian dari kehidupan sehari-hari. Ukurannya yang besar menunjukkan bahwa perjalanan air bisa melibatkan banyak orang dan barang sekaligus. Menempatkannya di kompleks rumah adat membantu pengunjung melihat hubungan antara kampung di tepi danau dan wilayah seberang.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">perahu tradisional Danau Toba</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Tepi Danau Toba</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kayu</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Parhalaan</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Parhalaan adalah kalender tradisional Batak dan menjadi salah satu koleksi andalan museum. Isinya mencatat penanggalan dan penanda waktu yang dipakai untuk menentukan kapan bercocok tanam atau menggelar upacara. Keberadaan kalender seperti ini menunjukkan bahwa masyarakat Batak mengamati musim dan peredaran bulan secara cermat sebelum ada kalender modern. Bagi pengunjung, parhalaan menjelaskan bagaimana kegiatan pertanian dan adat di kawasan Danau Toba diatur oleh waktu yang disepakati bersama.</sdp:exhibitDescription>
        <sdp:exhibitOrigin xml:lang="id">Kawasan Samosir</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kayu atau tulang bertulis</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikipedia: Museum Huta Bolon Simanindo</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://id.wikipedia.org/wiki/Museum_Huta_Bolon_Simanindo</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center">
        <rdfs:label xml:lang="id">Museum TB Silalahi Center</rdfs:label>
        <sdp:description xml:lang="id">Didirikan di Balige dengan koleksi seni dan artefak Batak yang dikumpulkan secara pribadi. Tata pamernya modern dan menyertakan ruang audiovisual tentang budaya Danau Toba.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/sumatera-utara"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/toba"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/2"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/seni-budaya"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/modern"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2008</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Patuan Nagari, Balige, Kabupaten Toba</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.3333</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">99.0667</sdp:longitude>
        <sdp:history xml:lang="id">Museum TB Silalahi Center berada di Balige, Kabupaten Toba, dan berdiri sebagai pusat budaya Batak. Kompleksnya memuat bangunan utama bernama T.B. Silalahi Building serta sejumlah rumah adat Karo di sekitarnya.

Museum ini dikenal juga sebagai Museum Batak. Selain ruang pameran, kawasannya menampilkan rumah tradisional dan panorama Danau Toba.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/exhibit/3"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/source/1"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#PrivateMuseum"/>
        <sdp:hasFacility rdf:resource="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/facility/1"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-tb-silalahi-center/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-tb-silalahi-center/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Gedung T.B. Silalahi</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Bangunan utama ini adalah wajah kompleks T.B. Silalahi Center, pusat budaya Batak di Balige. Selain sebagai museum, tempat ini dipakai sebagai ruang kegiatan budaya, sehingga fungsinya lebih luas daripada museum pada umumnya.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">kompleks budaya modern</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum TB Silalahi Center — foto dari Wikimedia Commons</sdp:imageAlt>
