        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Siginjai, ikat pinggang pusaka</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Benda pusaka kesultanan Jambi yang menjadi asal nama museum.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Keramik Cina</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Keramik dari jalur perdagangan Batanghari yang menunjukkan hubungan Jambi dengan Cina.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Arca dan benda megalitik</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Temuan arkeologis dari kawasan hulu Batanghari, termasuk arca dan benda batu masa megalitik.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Stempel dan arsip kesultanan</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Stempel serta dokumen yang berkaitan dengan Kesultanan Jambi dan masa pemerintahan kolonial.</sdp:exhibitDescription>
    </sdp:Exhibit>

