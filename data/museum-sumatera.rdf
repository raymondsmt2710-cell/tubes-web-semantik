    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-sulaiman-badrul-alamsyah/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Duplikat cogan Johor–Riau–Lingga</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Duplikat alat kebesaran kerajaan dari emas dan perak bertahtakan permata mirah, dengan lempengan emas berbentuk daun sirih berinskiripsi Arab Melayu.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-sulaiman-badrul-alamsyah/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Ruang Tanjungpinang Kota Bermula</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang yang mengisahkan awal terbentuknya kota pelabuhan Tanjungpinang.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-sulaiman-badrul-alamsyah/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Ruang Budaya Bahari dan Keramik</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Keramik, kendi, piring, dan guci yang mencerminkan jalur perdagangan maritim Kepulauan Riau.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-sulaiman-badrul-alamsyah/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Ruang Alam Perkawinan Melayu</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Benda dan tata cara perkawinan adat Melayu yang ditampilkan sebagai satu ruang khusus.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-sulaiman-badrul-alamsyah/exhibit/5">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Temuan neolitikum</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Kapak genggam, kapak batu, dan beliung persegi berbahan andesit dari koleksi prasejarah.</sdp:exhibitDescription>
    </sdp:Exhibit>

