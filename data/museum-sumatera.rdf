    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-malikussaleh/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-malikussaleh/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Gerbang masuk kawasan Samudera Pasai</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Dari gerbang ini pengunjung masuk ke kawasan permukiman yang dahulu menjadi pusat Samudera Pasai, dikelilingi kebun kelapa dan sawah. Nama Malikussaleh merujuk sultan pertama kerajaan itu, yang makamnya menjadi salah satu situs utama di kawasan ini.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">kawasan bekas kerajaan</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Malikussaleh — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">merupakan museum khusus yang dibangun secara bertahap mulai tahun 2011 sampai dengan 2016 dengan Dana Otsus Kabupaten Aceh Utara. Luas tapakan bangunan ± 500 m2. Bangunan permanen </sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">DISDIKBUD Aceh Utara</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">Public domain</sdp:imageLicense>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AMuseum_islam_samudera_pasai_1.jpg</sdp:imageSource>
