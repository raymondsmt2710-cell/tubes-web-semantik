        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/source/1"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-huta-bolon-simanindo/1.jpg</sdp:imageUrl>
