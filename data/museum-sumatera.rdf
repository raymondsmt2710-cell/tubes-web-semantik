    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai">
        <rdfs:label xml:lang="id">Museum Siginjai</rdfs:label>
        <sdp:description xml:lang="id">Museum yang mengangkat nama siginjai, ikat pinggang pusaka raja Jambi. Koleksinya mencakup keramik Cina, arca, dan benda upacara masyarakat Jambi.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/jambi"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/jambi"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/5"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/arkeologi"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kemerdekaan"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1988</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Prof. Dr. Sri Soedewi, Jambi</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-1.6044</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">103.5811</sdp:longitude>
        <sdp:history xml:lang="id">Museum Siginjai dibangun pada 18 Februari 1981 oleh Gubernur Jambi Masjchun Syofwan dan diresmikan pada 6 Juni 1988 oleh Menteri Pendidikan dan Kebudayaan Fuad Hassan. Awalnya museum ini bernama Museum Negeri Jambi, dan kini dikenal juga sebagai Museum Siginjei.

Namanya merujuk siginjai, ikat pinggang pusaka raja Jambi. Museum berdiri di Jalan Jenderal Urip Sumoharjo, kawasan Sungai Putri, Telanaipura, Kota Jambi, dan menyimpan ribuan koleksi budaya Melayu Jambi.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/4"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/source/1"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/source/2"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-siginjai/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

