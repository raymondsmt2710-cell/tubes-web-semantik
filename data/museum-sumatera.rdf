        <sdp:imageCaption xml:lang="id">Tanah Lampung Museum or Lampung Museum is a museum located in Bandar Lampung City, Lampung province, Indonesia</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Khooirullyhaagakk</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://creativecommons.org/publicdomain/zero/1.0/deed.en</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3ABERKUNJUNG_DI_MUSEUM_LAMPUNG.jpg</sdp:imageSource>
    </sdp:Image>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-lampung/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Koleksi adat Saibatin dan Pepadun</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Benda budaya dari dua golongan adat Lampung yang menjadi nama museum.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-lampung/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Tenun dan pakaian adat</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Kain tenun serta busana tradisional Lampung.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-lampung/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Perlengkapan upacara</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Benda yang dipakai dalam upacara adat masyarakat Lampung.</sdp:exhibitDescription>
    </sdp:Exhibit>

