    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tsunami-aceh/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Lorong cerobong gelombang</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Lorong masuk museum ini sempit, tinggi, dan berkelok, dirancang menyerupai gelombang tsunami yang sedang menggulung. Pengunjung melewatinya sebagai pengalaman pertama sebelum sampai ke ruang pamer, sehingga suasana sudah terbentuk sejak pintu. Dindingnya berlapis dan cahaya masuk dari celah di atas, membuat ruang terasa pengap sekaligus megah. Pilihan rancangan ini menjadikan lorong bukan sekadar jalan masuk, melainkan bagian dari cara museum menyampaikan peristiwa 26 Desember 2004.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">dibangun 2008</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Rancangan museum peringatan tsunami</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">beton dan dinding berlapis</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tsunami-aceh/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Simulasi elektronik gempa dan tsunami</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Pameran ini menggambarkan proses gempa dan tsunami Samudra Hindia 2004 secara elektronik, sehingga pengunjung bisa mengikuti rangkaian kejadian dan bukan hanya melihat akibatnya. Penjelasannya menautkan gempa di dasar laut dengan gelombang yang menghantam pesisir Aceh. Bagi museum kebencanaan, bagian seperti ini berfungsi sebagai alat belajar: pengunjung diharapkan memahami tanda-tanda bahaya dan jalur evakuasi. Karena itu museum juga dirancang sebagai tempat evakuasi darurat bila tsunami terjadi lagi.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">peristiwa 26 Desember 2004</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Ruang pamer tetap museum</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">perangkat elektronik dan panel tampilan</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tsunami-aceh/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Diorama 26 Desember 2004</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Diorama ini menggambarkan kejadian tsunami sekaligus menampilkan benda-benda yang terbawa gelombang dan kemudian disimpan sebagai koleksi. Salah satu yang paling dikenal adalah maket masjid yang sebagian bangunannya menonjol keluar dari dinding, dikelilingi serakan kayu dan puing. Banyak masjid di pesisir Aceh hancur atau berdiri miring oleh hantaman gelombang, sementara bangunan yang selamat seperti Masjid Baiturrahman kemudian menjadi titik berkumpul penyintas. Susunan diorama sengaja dibuat sebagai ruang belajar bencana, bukan galeri foto korban.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">26 Desember 2004</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Koleksi dan rekonstruksi museum</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">maket, kayu, dan benda temuan</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tsunami-aceh/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Ruang kisah penyintas</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang ini memuat foto korban dan kesaksian para penyintas yang disusun sebagai tempat refleksi. Panel-panelnya tidak berhenti pada angka kerugian, tetapi menampilkan pengalaman orang yang selamat, kehilangan keluarga, dan membangun kembali kehidupan. Cara penyajian seperti ini lazim di museum bencana: kesaksian pribadi membuat peristiwa berskala besar bisa dipahami secara manusiawi. Karena isinya menyentuh, ruang ini biasanya dilewati pengunjung dengan tempo lebih lambat daripada ruang diorama.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">kesaksian 2004 dan sesudahnya</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Dokumentasi museum</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">foto, panel teks, dan rekaman</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-tsunami-aceh/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikipedia: Museum Tsunami Aceh</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://id.wikipedia.org/wiki/Museum_Tsunami_Aceh</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien">
        <rdfs:label xml:lang="id">Museum Cut Nyak Dhien</rdfs:label>
        <sdp:description xml:lang="id">Menempati rumah panggung tempat Cut Nyak Dhien ditangkap pada 1905. Ruang pamer menyimpan replika pakaian, senjata, dan diorama yang mengisahkan perjuangan Aceh melawan kolonial.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/aceh"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/aceh-besar"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/1"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/perjuangan"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:address xml:lang="id">Lam Pisang, Aceh Besar</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.3878</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">95.4729</sdp:longitude>
        <sdp:history xml:lang="id">Museum Cut Nyak Dhien menempati rumah tradisional Aceh di Gampong Lampisang, Kecamatan Peukan Bada, Aceh Besar. Rumah ini adalah kediaman Cut Nyak Dhien (lahir 1848), pejuang yang memimpin perlawanan terhadap Belanda setelah suaminya, Teuku Umar, gugur pada 1899.

Rumah aslinya dibakar Belanda pada 1896; yang tersisa hanya pondasi. Bangunan yang berdiri sekarang adalah hasil pemugaran pada 1981, sedangkan peresmiannya sebagai museum dilakukan pada 1987 oleh Menteri Pendidikan dan Kebudayaan Fuad Hassan.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/4"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/5"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/source/1"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#StateMuseum"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-cut-nyak-dhien/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-cut-nyak-dhien/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Cut Nyak Dhien setelah ditangkap</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Foto arsip Tropenmuseum ini memperlihatkan Cut Nyak Dhien bersama kerabatnya setelah tertangkap pada 1905 di pedalaman Aceh Besar, dalam kondisi sakit dan sudah berusia lanjut. Ia kemudian diasingkan ke Sumedang, Jawa Barat, dan meninggal di sana pada 1908. Foto semacam ini menjadi koleksi visual museum untuk menautkan kisah perlawanan dengan tokohnya secara langsung.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">1905</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Cut Nyak Dhien — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Reproduction negative(?). Cut Nyak Dhien (1848-1908) was the wife of Teuku Umar (1840-1899). After his death, she continued the struggle against the Dutch in Aceh, was taken prison</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Unknown author Unknown author</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 3.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/3.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3ACOLLECTIE_TROPENMUSEUM_Groepsportret_met_Cut_Nyak_Dhien_de_vrouw_van_Teuku_Umar_na_haar_gevangenneming_TMnr_10018822.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/1/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/1/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/1/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/1/detail/4"/>
    </sdp:Image>

