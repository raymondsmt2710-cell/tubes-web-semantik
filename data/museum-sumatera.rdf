        <sdp:detailText xml:lang="id">Ejaan “LIPP” menunjukkan dokumen dibuat sebelum pembaruan ejaan bahasa Indonesia.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/2/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Tanda tangan pejabat membantu memastikan masa penerbitan uang.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/2/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Benda seperti ini menjadi bukti kecil perubahan administrasi negara.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/3">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-bengkulu/3.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Perkakas masak dari tempurung</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Alat ini dibuat dari tempurung kelapa dan bilah kayu, dipakai sebagai sendok atau pengaduk dalam masakan tradisional Bengkulu. Koleksi rumah tangga seperti ini tampak sederhana, tetapi justru menunjukkan teknologi sehari-hari masyarakat yang tidak meninggalkan prasasti atau arsip tertulis.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">abad ke-19 hingga ke-20</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Negeri Bengkulu — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Traditional Bengkulu cooking utensils, Bengkulu Museum 2015-04-19</sdp:imageCaption>
