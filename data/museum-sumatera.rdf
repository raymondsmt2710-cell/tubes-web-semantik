    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-sulaiman-badrul-alamsyah/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-sultan-sulaiman-badrul-alamsyah/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Bekas Holland Irlandsch School</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Bangunan beratap limas ini dahulu sekolah dasar pertama di Tanjungpinang, Holland Irlandsch School (HIS), pada masa kolonial Belanda. Pada masa pendudukan Jepang namanya berubah menjadi Futsuko Gakka I, lalu menjadi Sekolah Rakyat setelah kemerdekaan. Sejak 31 Januari 2009 tempat ini menjadi museum.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">menjadi museum 31 Januari 2009</sdp:imagePeriod>
