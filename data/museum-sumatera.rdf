        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/exhibit/4"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/exhibit/5"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/source/1"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-adityawarman/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

