    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-taman-purbakala-sriwijaya/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Museum Sriwijaya</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Bangunan beratap limasan ini adalah museum di dalam Taman Purbakala Kerajaan Sriwijaya, kawasan bekas permukiman masa Sriwijaya di tepi Sungai Musi. Museum menyimpan temuan dari situs dan menjelaskan kehidupan masyarakat Sriwijaya.</sdp:imageBackground>
        <sdp:imageAlt xml:lang="id">Museum Taman Purbakala Kerajaan Sriwijaya — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">The Sriwijaya Museum in Srivijaya Archaeological Park, Palembang, South Sumatra, Indonesia.</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Gunawan Kartapranata</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 3.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/3.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3ATaman_Purbakala_Kerajaan_Sriwijaya_-_Museum_Sriwijaya.jpg</sdp:imageSource>
