        <sdp:detailText xml:lang="id">Keberadaan mata uang menunjukkan sistem ekonomi dan administrasi yang sudah mapan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-malikussaleh/image/3/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Masa kejayaannya sezaman dengan ramainya jalur dagang Selat Malaka.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-malikussaleh/image/3/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Benda sekecil ini menjelaskan sisi perdagangan kerajaan, bukan hanya sisi keagamaannya.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-malikussaleh/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Fragmen batu nisan Samudera Pasai</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Batu nisan berkaligrafi Arab ini berasal dari kompleks makam kerajaan Samudera Pasai dan menjadi bukti awal masuknya Islam di Sumatera. Tulisan pada nisan biasanya memuat nama, tarikh, dan kutipan keagamaan, sehingga bisa dipakai menelusuri siapa yang dimakamkan dan kapan. Bagi penelitian, nisan seperti ini lebih dapat dipercaya daripada kisah lisan karena tarikhnya tertulis. Kawasan Samudera Pasai sendiri tercatat sebagai kerajaan Islam pertama di Nusantara, dan makam sultan pertamanya menjadi salah satu situs utama di sini.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-13 hingga ke-16</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kompleks makam kerajaan Samudera Pasai</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">batu berkaligrafi</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-malikussaleh/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Mata uang kuno</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Koin dari masa kesultanan ini menunjukkan aktivitas perdagangan Samudera Pasai. Keberadaan mata uang sendiri menandakan kerajaan ini sudah memiliki sistem ekonomi dan administrasi yang mapan, bukan sekadar permukiman pesisir. Samudera Pasai berada di jalur dagang Selat Malaka, sehingga koin dan barang dagangan bergerak bersama kapal dari berbagai negeri. Bagi pengunjung, benda kecil ini menjelaskan sisi lain kerajaan yang biasanya dikenang hanya dari makam dan naskah.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-13 hingga ke-14</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kesultanan Samudera Pasai</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">logam</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-malikussaleh/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Temuan arkeologis kawasan situs</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Koleksi di kawasan situs berpusat pada tinggalan Samudera Pasai berupa fragmen, mata uang, dan temuan arkeologis dari sekitar bekas kota kerajaan. Temuan permukaan seperti pecahan keramik membantu menentukan batas permukiman lama dan jalur perdagangan yang melewatinya. Kawasan ini sekarang dikelilingi kebun kelapa dan sawah, sehingga bekas kota tidak lagi terlihat jelas di permukaan. Museum berfungsi merangkai temuan yang berserakan itu menjadi gambaran utuh, termasuk menautkannya dengan makam Malikussaleh yang menjadi salah satu situs utama di sini.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-13 hingga ke-16</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Sekitar bekas kota Samudera Pasai</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">keramik, logam, dan batu</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-malikussaleh/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikimedia Commons: Museum Islam Samudra Pasai</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File:Museum_Islam_Samudra_Pasai_2.jpg</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara">
        <rdfs:label xml:lang="id">Museum Negeri Provinsi Sumatera Utara</rdfs:label>
        <sdp:description xml:lang="id">Museum provinsi yang menyimpan koleksi budaya Batak, Melayu, Nias, dan etnis lain di Sumatera Utara. Bangunannya bekas kediaman seorang pedagang, dan halamannya memuat rumah adat serta meriam peninggalan.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/sumatera-utara"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/medan"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/2"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/seni-budaya"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kemerdekaan"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1954</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. H.M. Joni No. 51, Medan</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.5894</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">98.6747</sdp:longitude>
        <sdp:history xml:lang="id">Museum Negeri Provinsi Sumatera Utara berdiri di Jalan H.M. Jhoni No. 51, Medan. Peletakan batu pertama berupa sepasang makara dilakukan Presiden Soekarno pada 1954, dan museum diresmikan pada 19 April 1982 oleh Menteri Pendidikan dan Kebudayaan Daoed Joesoef.

Bangunannya menempati lahan sekitar 10.468 m² dengan gedung induk dua lantai yang memuat ruang pameran tetap dan temporer, ruang audio visual, perpustakaan, hingga ruang mikro film. Hingga 2005 museum mencatat 6.799 koleksi.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/exhibit/4"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/source/1"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#StateMuseum"/>
        <sdp:hasFacility rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/facility/1"/>
        <sdp:hasFacility rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/facility/2"/>
        <sdp:hasFacility rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/facility/3"/>
        <sdp:collectionSize rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6799</sdp:collectionSize>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-sumatera-utara/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-sumatera-utara/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Gedung induk museum</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Bangunan dua lantai ini berdiri di lahan sekitar 10.468 m² di Jalan H.M. Jhoni, Medan. Peletakan batu pertama berupa sepasang makara dilakukan Presiden Soekarno pada 1954, tetapi museum baru diresmikan pada 19 April 1982 oleh Menteri Pendidikan dan Kebudayaan Daoed Joesoef. Di gedung ini terdapat ruang pameran tetap, ruang pameran temporer, ruang audio visual, dan perpustakaan.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">diresmikan 1982</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Negeri Provinsi Sumatera Utara — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Museum Negeri Sumatera Utara Building</sdp:imageCaption>
