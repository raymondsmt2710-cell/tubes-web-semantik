    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/3">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-tb-silalahi-center/3.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Lanskap sekitar museum</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Hamparan sawah dan pepohonan ini adalah latar keseharian kompleks museum di Balige. Pemandangan seperti ini menjelaskan mengapa koleksi budaya di kawasan Danau Toba erat dengan pertanian, danau, dan kehidupan kampung. Lahan pertanian di sekitar Balige dikerjakan turun-temurun, dan hasilnya menjadi bagian dari kehidupan rumah tangga masyarakat Batak. Museum sengaja mempertahankan pandangan terbuka ini agar pengunjung melihat koleksi budaya dalam konteks tempat asalnya.</sdp:imageBackground>
        <sdp:imageAlt xml:lang="id">Museum TB Silalahi Center — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Natural scenery around T.B. Silalahi Center</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Sam Hidayat</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3ANatural_scenery_around_T.B._Silalahi_Center.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/3/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/3/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/3/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/3/detail/4"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/3/detail/5"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/3/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Hamparan sawah dan pepohonan ini adalah latar keseharian kompleks museum di Balige.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/3/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Pemandangan seperti ini menjelaskan mengapa koleksi budaya di kawasan Danau Toba erat dengan pertanian, danau, dan kehidupan kampung.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/3/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Danau dan kehidupan kampung menjadi bagian yang tidak terpisahkan dari kebudayaan setempat.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/3/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Lanskapnya juga memperlihatkan bahwa museum ini berada di kawasan pertanian, bukan pusat kota.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/3/detail/5">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Hamparan sawah ini sekaligus menjadi latar yang menyambungkan museum dengan kehidupan petani di sekitarnya.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Gedung T.B. Silalahi</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Bangunan utama ini adalah wajah kompleks T.B. Silalahi Center, pusat budaya Batak di Balige. Selain sebagai museum, tempat ini dipakai sebagai ruang kegiatan budaya, sehingga fungsinya lebih luas daripada museum pada umumnya. Artinya, pengunjung bisa menemukan pameran tetap sekaligus acara seperti pertunjukan atau pertemuan adat pada waktu tertentu. Posisinya di tepi Danau Toba menjadikan Balige titik yang mudah dicapai dari banyak kampung di sekitar danau.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">pusat budaya modern</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Balige, tepi Danau Toba</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">beton dan kaca</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Rumah adat Karo</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Rumah adat Karo beratap ijuk tinggi ini berdiri di kompleks museum sebagai pameran arsitektur. Kehadirannya menunjukkan bahwa kawasan Toba dihuni beberapa sub-etnis Batak dengan bentuk rumah yang berbeda: Karo di utara, Toba di sekitar danau. Atap ijuk yang menjulang adalah ciri yang mudah dibedakan dari rumah adat Toba. Dengan menempatkannya di sini, museum menjelaskan bahwa kebudayaan Batak tidak seragam, melainkan terdiri atas beberapa tradisi yang berdampingan.</sdp:exhibitDescription>
        <sdp:exhibitOrigin xml:lang="id">Kawasan Karo, Sumatera Utara bagian utara</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kayu dan atap ijuk</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Koleksi budaya Batak</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Koleksi ini berisi benda-benda budaya yang mengisahkan sejarah dan kehidupan masyarakat Batak di sekitar Danau Toba. Isinya mencakup perlengkapan rumah tangga, alat kerja, dan benda adat yang dipakai dalam kehidupan sehari-hari. Berbeda dari museum yang menonjolkan benda pusaka, koleksi semacam ini memperlihatkan sisi keseharian: bagaimana orang memasak, bertani, dan berpakaian. Karena kawasan Toba erat dengan pertanian dan danau, banyak benda di sini berkaitan dengan kedua hal itu.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-19 hingga ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Berbagai daerah Batak</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kain, kayu, dan logam</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikimedia Commons: T.B. Silalahi Center</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File:Front_view_of_T.B._Silalahi_Building,_Batak_Cultural_Center.jpg</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Facility rdf:about="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/facility/1">
        <sdp:facilityName xml:lang="id">ruang audiovisual</sdp:facilityName>
    </sdp:Facility>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-sisingamangaraja-xii">
        <rdfs:label xml:lang="id">Museum Sisingamangaraja XII</rdfs:label>
        <sdp:description xml:lang="id">Mengisahkan perlawanan Sisingamangaraja XII terhadap pemerintahan kolonial Belanda di Tanah Batak. Koleksinya mencakup senjata tradisional, foto sejarah, dan benda pribadi keluarga raja.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/sumatera-utara"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/toba"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/2"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/perjuangan"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:address xml:lang="id">Balige, Kabupaten Toba</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.3402</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">99.0708</sdp:longitude>
        <sdp:history xml:lang="id">Museum Sisingamangaraja XII di Balige, Kabupaten Toba, mengisahkan perlawanan Raja Sisingamangaraja XII terhadap pemerintahan kolonial Belanda di Tanah Batak pada akhir abad ke-19.

Koleksinya mencakup senjata tradisional, foto, dan benda peninggalan yang berkaitan dengan perjuangan Sisingamangaraja XII dan masyarakat Batak.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-sisingamangaraja-xii/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-sisingamangaraja-xii/image/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-sisingamangaraja-xii/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-sisingamangaraja-xii/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-sisingamangaraja-xii/exhibit/3"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-sisingamangaraja-xii/source/1"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#SiteMuseum"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#StateMuseum"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-sisingamangaraja-xii/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-sisingamangaraja-xii/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-sisingamangaraja-xii/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Makam di Bakkara</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Bakkara, di tepi Danau Toba, adalah kampung asal Sisingamangaraja dan kini menjadi kawasan makam raja-raja Batak. Kompleks makam ini berada di dekat museum yang mengisahkan perlawanan Sisingamangaraja XII terhadap Belanda, yang berakhir dengan gugurnya raja pada 1907.</sdp:imageBackground>
        <sdp:imageAlt xml:lang="id">Museum Sisingamangaraja XII — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Grave and en:Flag of King Sisingamangaraja</sdp:imageCaption>
