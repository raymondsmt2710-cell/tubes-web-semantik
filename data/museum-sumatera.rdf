    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-daerah-deli-serdang">
        <rdfs:label xml:lang="id">Museum Daerah Deli Serdang</rdfs:label>
        <sdp:description xml:lang="id">Museum kabupaten yang memamerkan koleksi etnografi Melayu Deli serta temuan arkeologis dari pesisir timur Sumatera Utara. Sering dipakai sebagai ruang pembelajaran sekolah setempat.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/sumatera-utara"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/deli-serdang"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/2"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/arkeologi"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kemerdekaan"/>
        <sdp:address xml:lang="id">Lubuk Pakam, Kabupaten Deli Serdang</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.5586</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">98.8759</sdp:longitude>
        <sdp:history xml:lang="id">Museum Deli Serdang dibangun mulai 2001 dengan dana APBD dan diresmikan pada 12 Agustus 2003 di kompleks perkantoran Tanjung Garbus I, Lubuk Pakam. Pada 2016 pemerintah kabupaten membangun museum baru di lahan eks Dinas Pertanian, yang diresmikan 8 September 2018 oleh Menteri Pendidikan dan Kebudayaan Muhadjir Effendy.

Bangunannya memakai konsep “Itik Pulang Petang” dari filosofi Melayu, yang bermakna keteraturan, kerapian, dan keharmonisan.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-daerah-deli-serdang/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-daerah-deli-serdang/image/2"/>
