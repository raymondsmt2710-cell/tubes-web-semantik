        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-istana-siak/exhibit/3"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-istana-siak/source/1"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-istana-siak/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

