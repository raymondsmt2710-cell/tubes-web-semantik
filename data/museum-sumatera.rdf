        <sdp:detailText xml:lang="id">Gedung museum ini memakai bentuk rumah gadang dengan atap melengkung.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/image/1/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Letaknya di Bonjol, kawasan yang menjadi pusat perlawanan kaum Padri.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/image/1/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Bentuk bangunan dipilih agar museum tampil sebagai bagian kebudayaan Minangkabau.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/image/1/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Di dalamnya tersimpan senjata, pakaian, naskah, dan perkakas dari masa Perang Padri.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-tuanku-imam-bonjol/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Patung Tuanku Imam Bonjol</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Patung putih penunggang kuda ini berdiri di halaman museum, menggambarkan Imam Bonjol sebagai pemimpin perang. Sosoknyalah yang memimpin kaum Padri dalam Perang Padri (1803–1838) melawan Belanda dan kaum adat, hingga akhirnya ditangkap dan diasingkan.</sdp:imageBackground>
        <sdp:imageAlt xml:lang="id">Museum Tuanku Imam Bonjol — foto dari Wikimedia Commons</sdp:imageAlt>
