        <sdp:exhibitTitle xml:lang="id">Parhalaan</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Kalender tradisional Batak yang menjadi salah satu koleksi andalan museum.</sdp:exhibitDescription>
    </sdp:Exhibit>

