    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-sisingamangaraja-xii/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-sisingamangaraja-xii/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Potret Sisingamangaraja XII</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Foto ini berasal dari arsip kolonial dan sudah menjadi domain publik. Sosok Sisingamangaraja XII digambarkan dalam busana kebesaran; potret semacam ini dipakai sebagai rujukan visual untuk patung, prangko, dan lukisan yang dibuat kemudian.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">arsip kolonial, domain publik</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Sisingamangaraja XII — foto dari Wikimedia Commons</sdp:imageAlt>
