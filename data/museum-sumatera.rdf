        <sdp:detailText xml:lang="id">Kini menjadi museum yang menyimpan regalia kesultanan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-istana-siak/image/3">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-istana-siak/3.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Kursi singgasana Kerajaan Siak Sri Indrapura</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Kursi berlapis emas ini dipajang di dalam lemari kaca dengan label “Kursi Singgasana Kerajaan Siak Sri Indrapura”. Singgasana adalah pusat upacara kerajaan: di sinilah sultan menerima pembesar dan tamu, sehingga posisinya dalam tata ruang istana menandai hierarki kekuasaan.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">masa Kesultanan Siak</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Istana Siak Sri Indrapura — foto dari Wikimedia Commons</sdp:imageAlt>
