    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/3">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-cut-nyak-dhien/3.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Patung Cut Nyak Dhien</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Patung ini berdiri di Museum Mandala Bhakti Wanitatama, Yogyakarta — bukan di Lampisang. Foto ini dipakai sebagai rujukan visual sosok Cut Nyak Dhien dalam busana dan sikap yang lazim digambarkan, karena museum di Lampisang tidak memiliki patung serupa di halamannya.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">patung modern</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Cut Nyak Dhien — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">The Statue of Cut Nyak Dhien at the Mandala Bhakti Wanitatama Museum.</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Sam Hidayat</sdp:imageCredit>
