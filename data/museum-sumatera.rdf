        <sdp:detailText xml:lang="id">Muntok pernah menjadi pusat pemerintahan dan pelabuhan penting di Bangka bagian barat.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/2/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Museum ini melengkapi koleksi serupa di Pangkalpinang.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/2/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Keberadaan dua museum menunjukkan luasnya kawasan penambangan timah.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-timah-indonesia/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Peralatan penambangan timah</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Artefak tambang ini menunjukkan cara timah dieksplorasi dan diolah sejak masa kolonial. Penambangan timah di Bangka dimulai jauh sebelum kemerdekaan dan menjadi salah satu alasan kawasan ini terhubung erat dengan pemerintah Hindia Belanda. Peralatan sederhana pada masa awal berbeda jauh dari mesin yang dipakai kemudian, dan perbedaan itu menunjukkan perubahan skala penambangan. Bagi pengunjung, benda semacam ini menjelaskan bahwa timah bukan hanya hasil tambang, tetapi bagian dari sejarah kerja banyak orang.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa kolonial hingga abad ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Pulau Bangka dan Belitung</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">logam, kayu, dan besi</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-timah-indonesia/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Galeri tambang darat dan laut</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Galeri ini membahas penambangan timah di darat, di lepas pantai, hingga proses peleburannya. Penambangan lepas pantai memerlukan cara yang berbeda dari tambang darat, termasuk kapal keruk dan penyaringan pasir. Peleburan juga menjadi bagian penting, karena timah baru bernilai setelah dipisahkan dari bahan lain. Dengan menjelaskan ketiga tahap itu, galeri memperlihatkan bahwa industri timah adalah rangkaian pekerjaan panjang, bukan hanya penggalian.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Bangka Belitung</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">panel, alat, dan model</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-timah-indonesia/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Miniatur lingkungan tambang</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Miniatur tiga dimensi ini menggambarkan lingkungan pertambangan dan permukiman pekerja. Yang ditampilkan bukan hanya lubang tambang, tetapi juga rumah pekerja, jalan, dan bangunan pendukung, karena pertambangan membentuk permukiman di sekitarnya. Maket dipilih karena pengunjung tidak dapat melihat kawasan tambang secara utuh dari dekat. Melalui miniatur, hubungan antara tambang, permukiman, dan pelabuhan bisa dipahami dalam sekali pandang.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kawasan pertambangan Bangka</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">maket tiga dimensi</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-timah-indonesia/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Koleksi etnografi Bangka</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang ini memuat pakaian tradisional dan peralatan sehari-hari masyarakat Bangka Belitung. Penduduk Bangka terbentuk dari campuran Melayu, Tionghoa, dan pendatang dari berbagai daerah yang datang untuk bekerja di tambang, sehingga budayanya bercampur. Peralatan rumah tangga menunjukkan bagaimana kehidupan diatur di kawasan yang dahulu sulit dijangkau. Bagian ini penting karena melengkapi kisah tambang dengan kisah orang-orang yang tinggal di sekitarnya.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-19 hingga ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Masyarakat Bangka Belitung</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kain dan peralatan rumah tangga</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-timah-indonesia/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikipedia: Museum Timah Indonesia Muntok</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://id.wikipedia.org/wiki/Museum_Timah_Indonesia_Muntok</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-timah-indonesia/source/2">
