    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-sulaiman-badrul-alamsyah">
        <rdfs:label xml:lang="id">Museum Sultan Sulaiman Badrul Alamsyah</rdfs:label>
        <sdp:description xml:lang="id">Menempati bekas istana Kesultanan Riau-Lingga di Pulau Penyengat dan sekitarnya. Koleksinya meliputi manuskrip Melayu, naskah keagamaan, dan benda kerajaan.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/kepulauan-riau"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/tanjungpinang"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/3"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/arkeologi"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:address xml:lang="id">Jl. Ketapang, Tanjungpinang</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.9186</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">104.4467</sdp:longitude>
        <sdp:history xml:lang="id">Museum Sultan Sulaiman Badrul Alamsyah diresmikan pada 31 Januari 2009 oleh Wali Kota Tanjungpinang, Suryatati Abdul Manan, dan dikelola Dinas Kebudayaan dan Pariwisata Kota Tanjungpinang. Lokasinya di Jalan Ketapang Nomor 2, Kelurahan Kemboja, Tanjungpinang Barat.

Gedungnya dahulu adalah sekolah dasar pertama di Tanjungpinang, Holland Irlandsch School (HIS), pada masa kolonial Belanda. Pada masa pendudukan Jepang namanya berubah menjadi Futsuko Gakka I, dan setelah kemerdekaan menjadi Sekolah Rakyat sebelum akhirnya dialihfungsikan sebagai museum.</sdp:history>
