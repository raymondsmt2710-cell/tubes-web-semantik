        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AMuseum_Rumah_Kelahiran_Buya_Hamka_2020.jpg</sdp:imageSource>
