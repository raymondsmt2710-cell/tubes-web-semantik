        <sdp:detailText xml:lang="id">Uang lama disimpan museum sebagai koleksi numismatika.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/1/detail/4">
