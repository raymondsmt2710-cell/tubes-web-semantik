    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/3/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Perkakas dapur ini dibuat dari tempurung kelapa.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/3/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Bahan alami dipakai karena mudah didapat dan tahan panas.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/3/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Setiap bentuk punya kegunaan khusus, misalnya menanak nasi atau menyimpan air.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/3/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Pengetahuan membuat dan memakai perkakas seperti ini mulai hilang sejak aluminium dan plastik masuk.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Perkakas masak tradisional Bengkulu</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang ini memuat peralatan dapur dari bahan alami yang mencerminkan kehidupan rumah tangga masyarakat Bengkulu. Perkakas dari tempurung kelapa dan bambu dipakai karena mudah didapat dan tahan terhadap panas, bukan karena harganya murah semata. Setiap bentuk punya kegunaan khusus, misalnya untuk menanak nasi, mengaduk, atau menyimpan air. Bagi museum, peralatan seperti ini merekam pengetahuan praktis yang mulai hilang sejak aluminium dan plastik masuk ke dapur.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-19 hingga ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Rumah tangga masyarakat Bengkulu</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">tempurung, bambu, dan kayu</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Koleksi uang lama</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Uang kertas rupiah edisi lama ini disimpan sebagai koleksi numismatika. Salah satu yang ditampilkan adalah uang kertas seribu rupiah edisi lama, dan ada pula yang memuat tanda tangan pejabat dengan ejaan lama. Uang seperti ini berguna untuk menelusuri perubahan nilai, desain, dan lembaga yang menerbitkannya dari masa ke masa. Bagi pengunjung yang lebih muda, benda ini sering menjadi kejutan karena bentuknya sangat berbeda dari uang yang dipakai sekarang.</sdp:exhibitDescription>
        <sdp:exhibitOrigin xml:lang="id">Koleksi numismatika museum</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kertas</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Koleksi etnografi</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang ini memuat benda sehari-hari dan perlengkapan adat masyarakat Bengkulu. Bengkulu dihuni beberapa kelompok dengan bahasa dan adat berbeda, termasuk Rejang, Serawai, dan Melayu pesisir, sehingga koleksinya beragam. Perlengkapan adat biasanya dipakai pada upacara daur hidup seperti kelahiran, pernikahan, dan kematian. Karena itu museum menjelaskan asal benda dari kelompok mana, agar keragaman itu tidak tenggelam menjadi satu label “Bengkulu” yang terlalu umum.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-19 hingga ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Masyarakat Bengkulu</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kain, kayu, dan logam</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Uang kertas bertanda tangan lama</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Salah satu koleksi menampilkan uang kertas lima ratus rupiah bertanda tangan pejabat dengan ejaan lama. Perbedaan ejaan pada tanda tangan menunjukkan dokumen dibuat sebelum pembaruan ejaan bahasa Indonesia. Bagi peneliti, uang seperti ini membantu memastikan masa penerbitan dan pejabat yang menjabat pada saat itu. Dipamerkan bersama perkakas dapur, koleksi uang ini memberi gambaran bahwa perubahan alat tukar berlangsung bersamaan dengan perubahan barang sehari-hari.</sdp:exhibitDescription>
        <sdp:exhibitOrigin xml:lang="id">Koleksi numismatika museum</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kertas</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikimedia Commons: Traditional Bengkulu cooking utensils, Bengkulu Museum</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File:Traditional_Bengkulu_cooking_utensils,_Bengkulu_Museum_2015-04-19_01.jpg</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Collection rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/collection/1">
        <sdp:collectionCategory xml:lang="id">etnografi</sdp:collectionCategory>
    </sdp:Collection>

    <sdp:Collection rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/collection/2">
        <sdp:collectionCategory xml:lang="id">numismatika</sdp:collectionCategory>
    </sdp:Collection>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno">
        <rdfs:label xml:lang="id">Rumah Pengasingan Bung Karno</rdfs:label>
        <sdp:description xml:lang="id">Rumah tempat Soekarno diasingkan pada 1938–1942, kini dikelola sebagai museum. Ruangannya dipertahankan seperti masa itu, lengkap dengan barang pribadi dan dokumentasi pengasingan.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/bengkulu"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/bengkulu"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/5"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/perjuangan"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1938</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Soekarno-Hatta, Bengkulu</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-3.7985</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">102.2712</sdp:longitude>
        <sdp:history xml:lang="id">Rumah Pengasingan Bung Karno di Kota Bengkulu adalah tempat Soekarno menjalani hukuman pengasingan sebagai tahanan politik. Sebelumnya ia diasingkan ke Ende, Flores, pada 14 Januari 1934 selama empat tahun (1934–1938), lalu dipindahkan ke Bengkulu.

Rumah ini kini menjadi museum yang menyimpan jejak masa pengasingan tersebut, termasuk perabot dan benda yang berkaitan dengan kehidupan Soekarno di Bengkulu.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/exhibit/3"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/source/1"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#SiteMuseum"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/rumah-pengasingan-bung-karno/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/rumah-pengasingan-bung-karno/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Papan nama rumah pengasingan</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Papan ini menandai rumah tempat Soekarno diasingkan di Bengkulu setelah empat tahun di Ende, Flores (1934–1938). Rumah ini kemudian dijadikan museum dan dipelihara sebagai bagian dari perjalanan politik Soekarno sebelum proklamasi.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">museum sejak era 1980-an</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Rumah Pengasingan Bung Karno — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">This is Bung Karno&apos;s exile house, which until now still exists in Bengkulu City, This house made as Place for residence by Soekarno when undergoing exile in the year of 1938 - 1942</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Azizadisuryo</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3ARumah_Pengasingan_Bung_Karno_di_Kota_Bengkulu.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/1/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/1/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/1/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/1/detail/4"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/1/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Papan nama ini menandai rumah yang kini menjadi museum.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/1/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Bangunan aslinya dipakai Soekarno sebagai tempat tinggal selama diasingkan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/1/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Statusnya sebagai cagar budaya membuat bentuk bangunannya tidak banyak berubah.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/1/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Papan ini juga menandai alamat rumah yang biasa dicari pengunjung.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/rumah-pengasingan-bung-karno/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Halaman dan rumah pengasingan</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Rumah beratap limas dengan serambi lebar ini berdiri di atas halaman berpaving, dengan tiang bendera di depannya. Selama di Bengkulu, Soekarno aktif mengajar dan menulis; rumah ini menjadi saksi masa pengasingan yang relatif lebih longgar dibandingkan di Ende.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">1938–1942</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Rumah Pengasingan Bung Karno — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">In 1933 Soekarno was arrested on charges of carrying out movements and gathering the natives to fight the Dutch, then exiled to Ende, East Nusa Tenggara. After being exiled to Ende</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Herusutimbul</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3ARumah_Pengasingan_Bung_Karno.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/2/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/2/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/2/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/2/detail/4"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/2/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Halaman ini adalah bagian dari rumah pengasingan Soekarno di Bengkulu.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/2/detail/2">
