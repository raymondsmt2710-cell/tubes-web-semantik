    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/2/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Kehadirannya membuat taman purbakala juga menjadi ruang yang dipakai masyarakat.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/3">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-taman-purbakala-sriwijaya/3.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Arca Buddha dari masa Sriwijaya</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Arca Buddha yang sudah rusak ini ditemukan di kawasan Sriwijaya dan kini dipajang di halaman salah satu museum Palembang. Temuan arca menjadi bukti bahwa Sriwijaya adalah pusat kajian agama Buddha yang penting: banyak pelajar dari Cina dan India datang ke sini untuk menyalin kitab.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">masa Sriwijaya</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Taman Purbakala Kerajaan Sriwijaya — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">A fragmented Buddha statue was displayed at the yard of Sultan Mahmud Badaruddin II Museum in Palembang, then moved to Taman Purbakala Kerajaan Sriwijaya. The statue was discovered</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Gunawan Kartapranata. Anon</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3ABuddha_Seguntang_Palembang_(grayscale).jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/3/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/3/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/3/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/3/detail/4"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/3/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Arca Buddha ini berasal dari masa Sriwijaya.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/3/detail/2">
