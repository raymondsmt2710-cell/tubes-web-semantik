        <sdp:detailText xml:lang="id">Sriwijaya dikenal sebagai pusat pembelajaran Buddhisme di Asia Tenggara.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/3/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Catatan Tiongkok menyebut hubungan kawasan ini dengan pusat pendidikan agama di India.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/3/detail/4">
