    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo">
        <rdfs:label xml:lang="id">Museum Huta Bolon Simanindo</rdfs:label>
        <sdp:description xml:lang="id">Kompleks rumah adat Batak Toba di tepi Danau Toba yang difungsikan sebagai museum. Pengunjung dapat melihat rumah panggung, lumbung padi, dan pertunjukan tari Sigale-gale.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/sumatera-utara"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/samosir"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/2"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/seni-budaya"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:address xml:lang="id">Simanindo, Kabupaten Samosir</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.6853</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">98.7694</sdp:longitude>
        <sdp:history xml:lang="id">Museum Huta Bolon Simanindo menempati rumah tradisional Batak warisan Raja Sidauruk sejak 1969. Lokasinya di Desa Simanindo, Kecamatan Simanindo, Kabupaten Samosir, di tepi Danau Toba.

Kompleks ini terdiri atas dua susun rumah adat yang saling berhadapan, masing-masing lima rumah, dan menyimpan peninggalan leluhur orang Batak Samosir.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/3"/>
