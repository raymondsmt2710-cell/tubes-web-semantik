        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AMuseum_Rumah_Kelahiran_Buya_Hamka_2020.jpg</sdp:imageSource>
    </sdp:Image>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Rak buku karya Hamka</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Lima rak kaca berisi puluhan judul buku karangan Buya Hamka, bagian dari sekitar 200 judul koleksi museum.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Foto perjalanan hidup Hamka</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Foto Hamka sejak kanak-kanak, remaja, bersama tokoh nasional, hingga iring-iringan jenazahnya pada 1981.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Kamar tidur dan kelambu</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Tempat tidur dengan kelambu putih yang dahulu dipakai Hamka.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Benda pribadi keluarga</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Kursi peninggalan orang tua Hamka, lampu gantung kuno, koper haji pertama, delapan tongkat, dan baju wisuda lengkap dengan toga.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikipedia: Museum Kelahiran Buya Hamka</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://id.wikipedia.org/wiki/Museum_Kelahiran_Buya_Hamka</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol">
        <rdfs:label xml:lang="id">Museum Tuanku Imam Bonjol</rdfs:label>
        <sdp:description xml:lang="id">Berada di kawasan kelahiran Tuanku Imam Bonjol, pemimpin Perang Padri. Museum ini menampilkan diorama pertempuran, senjata, dan naskah yang berkaitan dengan perang tersebut.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/sumatera-barat"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/pasaman"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/4"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/perjuangan"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:address xml:lang="id">Bonjol, Kabupaten Pasaman</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0208</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.2222</sdp:longitude>
        <sdp:history xml:lang="id">Museum Tuanku Imam Bonjol dibangun sejak Oktober 1987 dan selesai pada 1990 di areal sekitar 2 hektar di Kecamatan Bonjol, Kabupaten Pasaman, tepat di tepi Jalan Lintas Sumatra. Pada 1998 pengelolaannya diserahkan dari Pemerintah Provinsi Sumatera Barat kepada Pemerintah Kabupaten Pasaman.

Desain bangunannya mengikuti rumah gadang Minangkabau dengan atap bergonjong. Dinding museum memuat catatan sejarah Perang Padri dan silsilah Muhammad Shahab, yang lahir di Bonjol pada 1 Januari 1772 dan dikenal sebagai Tuanku Imam Bonjol.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/4"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/5"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/source/1"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-tuanku-imam-bonjol/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

