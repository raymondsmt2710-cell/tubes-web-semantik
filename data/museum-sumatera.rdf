    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno">
        <rdfs:label xml:lang="id">Rumah Pengasingan Bung Karno</rdfs:label>
        <sdp:description xml:lang="id">Rumah tempat Soekarno diasingkan pada 1938–1942, kini dikelola sebagai museum. Ruangannya dipertahankan seperti masa itu, lengkap dengan barang pribadi dan dokumentasi pengasingan.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/bengkulu"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/bengkulu"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/5"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/perjuangan"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1938</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Soekarno-Hatta, Bengkulu</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-3.7985</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">102.2712</sdp:longitude>
        <sdp:history xml:lang="id">Rumah Pengasingan Bung Karno di Kota Bengkulu adalah tempat Soekarno menjalani hukuman pengasingan sebagai tahanan politik. Sebelumnya ia diasingkan ke Ende, Flores, pada 14 Januari 1934 selama empat tahun (1934–1938), lalu dipindahkan ke Bengkulu.

Rumah ini kini menjadi museum yang menyimpan jejak masa pengasingan tersebut, termasuk perabot dan benda yang berkaitan dengan kehidupan Soekarno di Bengkulu.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/exhibit/3"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/source/1"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/rumah-pengasingan-bung-karno/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/1">
