        <sdp:detailText xml:lang="id">Soekarno diasingkan ke sini pada 1938 dan tinggal sampai 1942.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/2/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Di halaman ini pula ia biasa menerima tamu dan berdiskusi.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/3">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/rumah-pengasingan-bung-karno/3.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Rumah pengasingan dari sisi jalan</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Dari arah jalan terlihat ubun-ubun bangunan dan pagar halaman. Arsip-arsip kolonial mencatat penangkapan Soekarno pada 1933 sebelum pengasingan berantai ke Flores lalu Bengkulu, sehingga rumah ini menandai babak politik tertentu dalam biografinya.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">arsitektur rumah kolonial</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Rumah Pengasingan Bung Karno — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Rumah kediaman Bung Karno pada waktu pengasingan di Bengkulu</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Penikmat Senja</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3ARumah_Bung_Karno_di_Bengkulu.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/3/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/3/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/3/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/3/detail/4"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/3/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Rumah pengasingan ini terlihat dari sisi jalan, memakai gaya rumah kolonial sederhana.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/3/detail/2">
