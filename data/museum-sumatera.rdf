        <sdp:detailText xml:lang="id">Kini dipertahankan sebagai museum dengan perabot dan benda pribadi keluarga.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/image/1/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Letaknya di tepi Danau Maninjau, kawasan yang banyak disebut dalam karya Hamka.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-rumah-kelahiran-buya-hamka/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Serambi rumah museum</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Serambi beratap ini menjadi ruang masuk museum, dengan ukiran Minang pada bagian atap dan dinding. Di dalamnya tersimpan sekitar 200 judul buku, lima rak kaca karya Hamka, serta benda pribadi seperti koper haji pertama, delapan tongkat, dan baju wisuda lengkap dengan toga.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">rumah tinggal awal abad ke-20</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Rumah Kelahiran Buya Hamka — foto dari Wikimedia Commons</sdp:imageAlt>
