    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo">
        <rdfs:label xml:lang="id">Museum Purbakala Pugung Raharjo</rdfs:label>
        <sdp:description xml:lang="id">Situs megalitik di tengah perkebunan yang menyimpan batu berundak, arca, dan benteng tanah peninggalan masa pra-sejarah hingga klasik. Sebagian koleksinya dipamerkan di rumah joglo sederhana di dalam situs.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/lampung"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/lampung-timur"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/7"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/arkeologi"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/pra-kolonial"/>
        <sdp:address xml:lang="id">Sekampung Udik, Kabupaten Lampung Timur</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-5.3167</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">105.4833</sdp:longitude>
        <sdp:history xml:lang="id">Situs Purbakala Pugung Raharjo berada di Sekampung Udik, Kabupaten Lampung Timur, di tengah perkebunan. Kawasan ini menyimpan tinggalan masa prasejarah hingga masa klasik, mulai dari batu berundak dan arca hingga benteng tanah.

Situsnya menjadi salah satu rujukan penting untuk memahami masa megalitik di Lampung, ketika batu besar dipakai sebagai sarana pemujaan leluhur.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/image/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/exhibit/3"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/source/1"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-purbakala-pugung-raharjo/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-purbakala-pugung-raharjo/1.jpg</sdp:imageUrl>
