        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-sultan-mahmud-badaruddin-ii/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Lukisan pengasingan Sultan Mahmud Badaruddin II</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Lukisan ini menggambarkan pengasingan Sultan Mahmud Badaruddin II setelah Palembang jatuh ke tangan Belanda pada 1821. Peristiwa itu mengakhiri kedaulatan Kesultanan Palembang Darussalam, dan sejak itu wilayahnya diperintah sebagai koloni.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">masa pengasingan</sdp:imagePeriod>
