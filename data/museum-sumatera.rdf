        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AMuseum_Deli_Serdang_2022_Bennylin_14.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-daerah-deli-serdang/image/3/detail/1"/>
