    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/image/1/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Stasiun Sawahlunto ini dibangun untuk mengangkut batu bara dari tambang ke pelabuhan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/image/1/detail/2">
