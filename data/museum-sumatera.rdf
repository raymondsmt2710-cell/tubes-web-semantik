    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan">
        <rdfs:label xml:lang="id">Museum Negeri Sumatera Selatan Balaputra Dewa</rdfs:label>
        <sdp:description xml:lang="id">Museum provinsi Sumatera Selatan dengan koleksi arca Hindu-Buddha, keramik, dan tenun songket Palembang. Namanya diambil dari raja Sriwijaya, Balaputra Dewa.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/sumatera-selatan"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/palembang"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/6"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/arkeologi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kemerdekaan"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1978</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Srijaya Negara, Palembang</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-2.9761</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">104.7353</sdp:longitude>
        <sdp:history xml:lang="id">Museum Negeri Sumatera Selatan Balaputra Dewa berada di Jalan Srijaya Negara, Palembang. Namanya diambil dari Balaputra Dewa, raja Sriwijaya, dan bangunannya dikenal sebagai bekas Burgemeesterhuis atau rumah wali kota Palembang pada masa kolonial.

Museum ini menyimpan koleksi arca Hindu-Buddha, keramik, tekstil, serta tenun songket Palembang, dan menjadi rujukan utama sejarah Sumatera Selatan.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/2"/>
