        <sdp:exhibitDescription xml:lang="id">Bangunan utama museum yang menjadi wajah kompleks pusat budaya Batak.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/exhibit/2">
