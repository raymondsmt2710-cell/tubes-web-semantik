<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:geo="http://www.w3.org/2003/01/geo/wgs84_pos#"
    xmlns:sdp="https://museumsumatera.id/ontology#"
    xmlns:res="https://museumsumatera.id/resource/">

    <!-- Kelas -->

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Museum">
        <rdfs:label xml:lang="id">Museum</rdfs:label>
        <rdfs:comment xml:lang="id">Sebuah museum di Pulau Sumatera.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Province">
        <rdfs:label xml:lang="id">Provinsi</rdfs:label>
        <rdfs:comment xml:lang="id">Provinsi di Pulau Sumatera.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#City">
        <rdfs:label xml:lang="id">Kota atau Kabupaten</rdfs:label>
        <rdfs:comment xml:lang="id">Lokasi kota atau kabupaten.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Theme">
        <rdfs:label xml:lang="id">Tema</rdfs:label>
        <rdfs:comment xml:lang="id">Tema koleksi museum.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Era">
        <rdfs:label xml:lang="id">Era</rdfs:label>
        <rdfs:comment xml:lang="id">Periode sejarah yang diwakili koleksi.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Chapter">
        <rdfs:label xml:lang="id">Bab</rdfs:label>
        <rdfs:comment xml:lang="id">Bab dalam alur pameran.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Collection">
        <rdfs:label xml:lang="id">Koleksi</rdfs:label>
        <rdfs:comment xml:lang="id">Klasifikasi koleksi yang dimiliki museum.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Exhibit">
        <rdfs:label xml:lang="id">Isi Pameran</rdfs:label>
        <rdfs:comment xml:lang="id">Bagian atau koleksi yang dipamerkan di museum.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Image">
        <rdfs:label xml:lang="id">Gambar</rdfs:label>
        <rdfs:comment xml:lang="id">Foto museum atau koleksi beserta kredit dan lisensinya.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#ImageDetail">
        <rdfs:label xml:lang="id">Poin Pengamatan Foto</rdfs:label>
        <rdfs:comment xml:lang="id">Satu butir pengamatan pada foto; beberapa butir membentuk daftar berurut.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Source">
        <rdfs:label xml:lang="id">Sumber</rdfs:label>
        <rdfs:comment xml:lang="id">Rujukan yang dipakai untuk menyusun catatan museum.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#StateMuseum">
        <rdfs:label xml:lang="id">Museum Negeri</rdfs:label>
        <rdfs:comment xml:lang="id">Museum yang dikelola pemerintah.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#SiteMuseum">
        <rdfs:label xml:lang="id">Museum Situs</rdfs:label>
        <rdfs:comment xml:lang="id">Museum situs/cagar atau bangunan bersejarah.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#PrivateMuseum">
        <rdfs:label xml:lang="id">Museum Swasta</rdfs:label>
        <rdfs:comment xml:lang="id">Museum milik yayasan atau perorangan.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Person">
        <rdfs:label xml:lang="id">Tokoh</rdfs:label>
        <rdfs:comment xml:lang="id">Orang yang terkait dengan museum.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Founder">
        <rdfs:label xml:lang="id">Pendiri</rdfs:label>
        <rdfs:comment xml:lang="id">Tokoh pendiri museum.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Curator">
        <rdfs:label xml:lang="id">Kurator</rdfs:label>
        <rdfs:comment xml:lang="id">Tokoh yang mengelola museum.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Facility">
        <rdfs:label xml:lang="id">Fasilitas</rdfs:label>
        <rdfs:comment xml:lang="id">Fasilitas yang tersedia di museum.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#HeritageStatus">
        <rdfs:label xml:lang="id">Status Cagar Budaya</rdfs:label>
        <rdfs:comment xml:lang="id">Status penetapan cagar budaya.</rdfs:comment>
    </owl:Class>

    <!-- Hierarki subkelas -->

    <owl:Class rdf:about="https://museumsumatera.id/ontology#StateMuseum">
        <rdfs:subClassOf rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <owl:disjointWith rdf:resource="https://museumsumatera.id/ontology#PrivateMuseum"/>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#SiteMuseum">
        <rdfs:subClassOf rdf:resource="https://museumsumatera.id/ontology#Museum"/>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#PrivateMuseum">
        <rdfs:subClassOf rdf:resource="https://museumsumatera.id/ontology#Museum"/>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Founder">
        <rdfs:subClassOf rdf:resource="https://museumsumatera.id/ontology#Person"/>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Curator">
        <rdfs:subClassOf rdf:resource="https://museumsumatera.id/ontology#Person"/>
    </owl:Class>

    <!-- Restriction cardinality pada Museum -->

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Museum">
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="https://museumsumatera.id/ontology#locatedInProvince"/>
            <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="https://museumsumatera.id/ontology#chapter"/>
            <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="https://museumsumatera.id/ontology#hasTheme"/>
            <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
        <owl:Restriction>
            <owl:onProperty rdf:resource="https://museumsumatera.id/ontology#locatedInCity"/>
            <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        </owl:Restriction>
    </rdfs:subClassOf>
    </owl:Class>

    <!-- Object property -->

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#locatedInProvince">
        <rdfs:label xml:lang="id">berlokasi di provinsi</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="https://museumsumatera.id/ontology#Province"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#locatedInCity">
        <rdfs:label xml:lang="id">berlokasi di kota</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="https://museumsumatera.id/ontology#City"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#partOfProvince">
        <rdfs:label xml:lang="id">bagian dari provinsi</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#City"/>
        <rdfs:range rdf:resource="https://museumsumatera.id/ontology#Province"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#hasTheme">
        <rdfs:label xml:lang="id">memiliki tema</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="https://museumsumatera.id/ontology#Theme"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#hasEra">
        <rdfs:label xml:lang="id">memiliki era</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="https://museumsumatera.id/ontology#Era"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#hasExhibit">
        <rdfs:label xml:lang="id">memiliki isi pameran</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#exhibitOfMuseum"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#hasImage">
        <rdfs:label xml:lang="id">memiliki foto</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#imageOfMuseum"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#hasSource">
        <rdfs:label xml:lang="id">memiliki sumber acuan</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#sourceOfMuseum"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#chapter">
        <rdfs:label xml:lang="id">berada di bab</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="https://museumsumatera.id/ontology#Chapter"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#hasCollection">
        <rdfs:label xml:lang="id">memiliki koleksi</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#collectionOfMuseum"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#hasFacility">
        <rdfs:label xml:lang="id">memiliki fasilitas</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#facilityOfMuseum"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#hasFounder">
        <rdfs:label xml:lang="id">memiliki pendiri</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#founderOfMuseum"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#hasCurator">
        <rdfs:label xml:lang="id">memiliki kurator</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="https://museumsumatera.id/ontology#Person"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#namedAfter">
        <rdfs:label xml:lang="id">dinamai menurut</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#isNamesakeOfMuseum"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#heritageStatusOf">
        <rdfs:label xml:lang="id">status cagar budaya</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#isHeritageStatusOf"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#relatedMuseum">
        <rdfs:label xml:lang="id">museum terkait</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="https://museumsumatera.id/ontology#Museum"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#imageOfMuseum">
        <rdfs:label xml:lang="id">kebalikan hasImage</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#hasImage"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#exhibitOfMuseum">
        <rdfs:label xml:lang="id">kebalikan hasExhibit</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#hasExhibit"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#sourceOfMuseum">
        <rdfs:label xml:lang="id">kebalikan hasSource</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#hasSource"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#collectionOfMuseum">
        <rdfs:label xml:lang="id">kebalikan hasCollection</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#hasCollection"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#facilityOfMuseum">
        <rdfs:label xml:lang="id">kebalikan hasFacility</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#hasFacility"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#founderOfMuseum">
        <rdfs:label xml:lang="id">kebalikan hasFounder</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#hasFounder"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#isNamesakeOfMuseum">
        <rdfs:label xml:lang="id">kebalikan namedAfter</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#namedAfter"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#isHeritageStatusOf">
        <rdfs:label xml:lang="id">kebalikan heritageStatusOf</rdfs:label>
        <owl:inverseOf rdf:resource="https://museumsumatera.id/ontology#heritageStatusOf"/>
    </owl:ObjectProperty>

    <!-- Datatype property -->

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#establishedYear">
        <rdfs:label xml:lang="id">tahun berdiri</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#description">
        <rdfs:label xml:lang="id">deskripsi</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#imageUrl">
        <rdfs:label xml:lang="id">tautan gambar</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#officialUrl">
        <rdfs:label xml:lang="id">situs resmi</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#address">
        <rdfs:label xml:lang="id">alamat</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#latitude">
        <rdfs:label xml:lang="id">lintang</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#longitude">
        <rdfs:label xml:lang="id">bujur</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#admissionNote">
        <rdfs:label xml:lang="id">catatan kunjungan</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#history">
        <rdfs:label xml:lang="id">sejarah museum</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#exhibitIndex">
        <rdfs:label xml:lang="id">urutan isi pameran</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Exhibit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#exhibitTitle">
        <rdfs:label xml:lang="id">judul isi pameran</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Exhibit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#exhibitDescription">
        <rdfs:label xml:lang="id">penjelasan isi pameran</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Exhibit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#exhibitPeriod">
        <rdfs:label xml:lang="id">masa atau tarikh benda</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Exhibit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#exhibitOrigin">
        <rdfs:label xml:lang="id">asal benda</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Exhibit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#exhibitMaterial">
        <rdfs:label xml:lang="id">bahan benda</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Exhibit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#exhibitHighlight">
        <rdfs:label xml:lang="id">benda andalan</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Exhibit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#imageIndex">
        <rdfs:label xml:lang="id">urutan foto</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Image"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#imageTitle">
        <rdfs:label xml:lang="id">judul foto</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Image"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#imageBackground">
        <rdfs:label xml:lang="id">latar belakang foto</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Image"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#imagePeriod">
        <rdfs:label xml:lang="id">masa atau tarikh foto</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Image"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#imageDetail">
        <rdfs:label xml:lang="id">poin pengamatan foto</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Image"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#detailIndex">
        <rdfs:label xml:lang="id">urutan poin pengamatan foto</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#ImageDetail"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#detailText">
