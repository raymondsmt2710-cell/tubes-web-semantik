    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Ruang Masa Prasejarah</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang pertama ini menampilkan sejarah geologi, pergeseran benua, migrasi manusia, serta replika hewan khas Sumatera dan fosil manusia purba. Alurnya dimulai dari terbentuknya Pulau Sumatera, sehingga pengunjung memahami bahwa daratan ini pernah menyatu dan bergeser sebelum dihuni manusia. Replika hewan dipakai karena fosil utuh jarang ditemukan, sedangkan fosil manusia purba memberi petunjuk kapan manusia pertama tiba di kawasan ini. Menempatkan ruang ini di awal menjadikan geologi sebagai dasar sebelum museum bercerita tentang kerajaan dan kolonialisme.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">prasejarah hingga masa migrasi</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Ruang pamer tetap, lantai koleksi geologi</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">fosil, replika hewan, dan panel geologi</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Arca Hindu-Buddha</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Arca ini peninggalan masa Hindu-Buddha dan menjadi bagian koleksi sejarah kuno Sumatera Utara. Keberadaannya menunjukkan bahwa pengaruh India masuk ke pedalaman Sumatera, bukan hanya ke pesisir dan kerajaan besar di Jawa. Arca semacam ini biasanya ditemukan tidak lengkap, sehingga penjelasan museum mengenai bagian yang hilang sama pentingnya dengan yang tersisa. Bagi pengunjung, benda ini adalah bukti bahwa sebelum kesultanan Islam berdiri, kawasan ini sudah melewati masa keagamaan lain.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa Hindu-Buddha</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Temuan di wilayah Sumatera Utara</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">batu</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Replika Masjid Azizi</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Replika ini mewakili Masjid Azizi di Tanjung Pura, Langkat, yang menjadi penanda masuknya Islam di pesisir timur Sumatera Utara. Memilih masjid sebagai objek pameran menunjukkan bahwa Islam di kawasan ini berkembang lewat kesultanan dan jaringan dagang pesisir, bukan lewat penaklukan. Bentuk masjidnya yang berlapis dan berkubah menjadi ciri arsitektur Melayu pesisir. Karena berupa replika, pengunjung memperoleh gambaran bentuk keseluruhan tanpa harus membawa bangunan aslinya ke ruang pamer.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa masuknya Islam di pesisir timur</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Tanjung Pura, Langkat</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">replika</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Ruang kolonial dan kepahlawanan</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang ini memuat perkakas masa Kolonial Belanda, model figur kolonial, poster propaganda perang, serta lukisan dan foto para pahlawan serta gubernur Sumatera Utara. Poster propaganda menarik diperhatikan karena menunjukkan bagaimana kedua pihak membentuk opini publik lewat gambar dan slogan. Lukisan gubernur menandai peralihan kekuasaan dari kolonial ke pemerintahan republik. Dengan menempatkan keduanya dalam satu ruang, museum memperlihatkan masa kolonial dan masa kepahlawanan sebagai dua sisi dari periode yang sama.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-19 hingga kemerdekaan</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Masa Kolonial Belanda dan perang kemerdekaan</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">perkakas, model figur, poster, lukisan, dan foto</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/source/1">
