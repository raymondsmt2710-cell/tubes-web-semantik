    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-malikussaleh/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Fragmen batu nisan Samudera Pasai</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Batu nisan berkaligrafi Arab dari kompleks makam kerajaan, menjadi bukti awal masuknya Islam di Sumatera.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-malikussaleh/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Mata uang kuno</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Koin dari masa kesultanan yang menunjukkan aktivitas perdagangan Samudera Pasai.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-malikussaleh/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
