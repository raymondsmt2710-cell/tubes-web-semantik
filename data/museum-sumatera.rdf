    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/3/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Stempel ini adalah cap Dewan Patih Kesultanan Jambi.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/3/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Dewan Patih menunjukkan pemerintahan dijalankan beberapa lembaga, bukan sultan seorang diri.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/3/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Stempel dipakai sebagai bukti keabsahan surat dan keputusan kesultanan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/3/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Benda seperti ini menjadi rujukan penting dalam penelitian arsip lama.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Siginjai, ikat pinggang pusaka</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Siginjai adalah benda pusaka kesultanan Jambi yang menjadi asal nama museum. Ikat pinggang pusaka semacam ini dipakai dalam upacara kebesaran, sehingga keberadaannya menandai siapa yang berhak tampil sebagai sultan. Benda pusaka di banyak kesultanan Sumatera berfungsi sebagai bukti keabsahan kekuasaan, bukan hanya perhiasan. Karena itu Siginjai lebih tepat dipahami sebagai simbol politik, dan namanya dipilih untuk museum agar kaitannya dengan kesultanan tetap terlihat.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa Kesultanan Jambi</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kesultanan Jambi</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">logam dan kain</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Keramik Cina</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Keramik ini berasal dari jalur perdagangan Batanghari dan menunjukkan hubungan Jambi dengan Cina. Sungai Batanghari dapat dilayari cukup jauh ke pedalaman, sehingga barang impor bisa sampai ke kawasan yang jauh dari laut. Warna dan motif keramik membantu menentukan masa pembuatannya, dan dengan begitu juga masa ramainya perdagangan di jalur itu. Bagi pengunjung, pecahan keramik yang tampak sederhana sebenarnya adalah bukti hubungan dagang jarak jauh yang berlangsung berabad-abad.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-14 hingga ke-19</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Jalur perdagangan Batanghari</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">keramik</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Arca dan benda megalitik</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang ini memuat temuan arkeologis dari kawasan hulu Batanghari, termasuk arca dan benda batu masa megalitik. Benda megalitik lebih tua daripada arca bercorak Hindu-Buddha, sehingga ruang ini menyimpan dua masa yang berbeda. Menempatkannya berdekatan membantu pengunjung melihat bahwa kawasan hulu Batanghari dihuni terus-menerus, dengan kepercayaan yang berganti. Karena temuan dari kawasan itu sering tidak lengkap, keterangan museum menjadi kunci untuk memahaminya.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa megalitik hingga masa klasik</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Hulu Batanghari</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">batu</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Stempel dan arsip kesultanan</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang ini memuat stempel serta dokumen yang berkaitan dengan Kesultanan Jambi dan masa pemerintahan kolonial. Stempel kesultanan adalah bukti tertulis bahwa sebuah keputusan benar-benar dikeluarkan oleh pihak berwenang, sehingga diperhatikan dalam penelitian surat-surat lama. Salah satu yang ditampilkan adalah stempel Dewan Patih Kesultanan Jambi, yang menunjukkan bahwa pemerintahan dijalankan oleh beberapa lembaga, bukan sultan seorang diri. Arsip semacam ini melengkapi kisah kesultanan yang biasanya diketahui dari cerita lisan.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa Kesultanan Jambi dan kolonial</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kesultanan Jambi</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">logam dan kertas</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/5">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Instalasi Kilang Avigas</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Instalasi Kilang Avigas menjadi bagian koleksi yang mengingatkan masa industri di Jambi. Avigas berkaitan dengan pengolahan gas dan bahan bakar pada masa ketika kawasan ini mulai terhubung dengan kegiatan pertambangan dan perkebunan. Kehadiran benda industri di museum daerah jarang ditemui, karena sebagian besar koleksi berpusat pada benda budaya. Bagian ini berguna untuk menunjukkan bahwa sejarah Jambi tidak berhenti pada kesultanan, tetapi berlanjut ke masa usaha dan industri.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kawasan Jambi</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">logam dan pipa</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Museum.co.id: Museum Siginjai Jambi</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://museum.co.id/directory-museum/listing/museum-siginjai-jamb/</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/source/2">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wonderful Indonesia: Museum Siginjei</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.indonesia.travel/id/id/travel-ideas/heritage/siginjei-museum</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu">
        <rdfs:label xml:lang="id">Museum Negeri Bengkulu</rdfs:label>
        <sdp:description xml:lang="id">Museum provinsi dengan koleksi budaya Rejang, Serawai, dan Enggano. Terdapat pula koleksi sejarah alam serta replika bunga rafflesia yang menjadi ikon Bengkulu.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/bengkulu"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/bengkulu"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/5"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/sejarah-alam"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kemerdekaan"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1978</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Pembangunan No. 08, Bengkulu</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-3.7956</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">102.2658</sdp:longitude>
        <sdp:history xml:lang="id">Museum Negeri Bengkulu adalah museum provinsi yang mengumpulkan benda budaya dan sejarah masyarakat Bengkulu, dari perkakas rumah tangga tradisional hingga mata uang lama.

Koleksinya banyak berupa benda etnografi, seperti peralatan memasak tradisional Bengkulu, serta uang kertas rupiah lama yang kini menjadi koleksi numismatika.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/exhibit/4"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/source/1"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#StateMuseum"/>
        <sdp:hasCollection rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/collection/1"/>
        <sdp:hasCollection rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/collection/2"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-bengkulu/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-bengkulu/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Uang kertas 1000 rupiah edisi lama</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Lembaran ini adalah uang kertas 1000 rupiah yang sudah tidak berlaku, disimpan dalam plastik pelindung dengan nomor inventaris 06-211. Koleksi numismatika seperti ini menandai perubahan mata uang Indonesia dari masa ke masa, termasuk masa inflasi tinggi pada 1960-an.</sdp:imageBackground>
        <sdp:imageAlt xml:lang="id">Museum Negeri Bengkulu — foto dari Wikimedia Commons</sdp:imageAlt>
