        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikipedia: Museum Aceh</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://id.wikipedia.org/wiki/Museum_Aceh</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-tsunami-aceh">
        <rdfs:label xml:lang="id">Museum Tsunami Aceh</rdfs:label>
        <sdp:description xml:lang="id">Dibangun sebagai peringatan bencana tsunami 26 Desember 2004. Lorong masuknya berbentuk gelombang, dan ruang pamer berisi foto, benda peninggalan, serta kisah penyintas yang disusun sebagai ruang refleksi.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/aceh"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/banda-aceh"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/1"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/sejarah-alam"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/seni-budaya"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/modern"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2009</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Sultan Iskandar Muda, Banda Aceh</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.5476</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">95.3153</sdp:longitude>
        <sdp:history xml:lang="id">Museum Tsunami Aceh dirancang sebagai monumen simbolis untuk mengenang gempa bumi dan tsunami Samudra Hindia pada 26 Desember 2004, sekaligus menjadi pusat pendidikan kebencanaan dan tempat evakuasi darurat bila tsunami terjadi lagi.

Pembangunannya dimulai pada 2008 dengan dana bantuan negara-negara donor yang dikoordinasikan BRR, lalu selesai pada akhir tahun yang sama. Museum diresmikan oleh Presiden Susilo Bambang Yudhoyono pada 2009 dan dibuka untuk publik pada 2011.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-tsunami-aceh/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-tsunami-aceh/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-tsunami-aceh/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-tsunami-aceh/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-tsunami-aceh/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-tsunami-aceh/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-tsunami-aceh/exhibit/4"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-tsunami-aceh/source/1"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-tsunami-aceh/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

