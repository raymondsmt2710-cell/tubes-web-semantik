        <sdp:exhibitDescription xml:lang="id">Arca dan benda megalitik dari kawasan hulu Sungai Batanghari.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-jambi/exhibit/3">
