    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-sumatera-utara/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Panel sejarah Provinsi Sumatera Utara</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Panel di ruang pamer ini mencatat bahwa Provinsi Sumatera Utara dibentuk lewat Undang-Undang Nomor 10 Tahun 1948, yang membagi Pulau Sumatera menjadi tiga provinsi. Isi panel menjadi contoh bagaimana museum tidak hanya memamerkan benda, tetapi juga menyusun kronologi pemerintahan sebagai bagian dari narasi sejarah daerah.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">Undang-Undang Nomor 10 Tahun 1948</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Negeri Provinsi Sumatera Utara — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Museum Negeri Sumatera Utara adalah salah satu museum terbesar di Sumatera Utara yang berbagai peninggalan sejarah budaya bangsa, hasil seni dan kerajinan dari berbagai suku di Sum</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Najla Khairani Siregar</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3ASejarah_Provinsi_Sumatera_Utara_di_Museum_Negeri_Sumatera_Utara.jpg</sdp:imageSource>
