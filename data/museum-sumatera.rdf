    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/image/2/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Gundukan berundak ini berada di tengah perkebunan warga.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/image/2/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Letaknya yang menyatu dengan kebun menunjukkan situs berada di lahan yang masih dipakai.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/image/2/detail/3">
