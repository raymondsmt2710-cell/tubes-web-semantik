        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-sultan-sulaiman-badrul-alamsyah/exhibit/5"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-sultan-sulaiman-badrul-alamsyah/source/1"/>
