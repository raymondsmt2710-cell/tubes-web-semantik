    </sdp:Image>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Surat dan dokumen Cut Nyak Dhien</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Surat-surat serta dokumen asli yang menunjukkan cara ia menyusun strategi perlawanan.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Foto masa pengasingan</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Foto wajah Cut Nyak Dhien semasa diasingkan di Sumedang, Jawa Barat.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Diorama perlawanan Aceh</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Diorama dan foto yang menggambarkan peristiwa penting dalam perang Aceh melawan Belanda.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Tata ruang kamar yang menyamar</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Kamar dayang-dayang sengaja diletakkan di depan dan kamar Cut Nyak Dhien di belakang, agar ia punya waktu meloloskan diri bila diserang mendadak.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/5">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Rumoh Aceh 65 tiang</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Rumah panggung berukuran 25 × 17 meter dengan 65 tiang kayu, atap rumbia, dan ukiran kayu ulin yang dirancang tahan gempa.</sdp:exhibitDescription>
    </sdp:Exhibit>

