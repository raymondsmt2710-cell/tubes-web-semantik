    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-istana-siak/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Bangunan Istana Siak</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Istana itu sendiri adalah pameran utama: arsitektur Melayu dengan ornamen dan tata ruang kerajaan. Fasadnya berwarna krem dan memadukan bentuk Eropa seperti menara, jendela lengkung runcing, dan pintu melengkung dengan tata ruang istana Melayu. Perpaduan itu bukan kebetulan, karena istana dibangun pada masa Sultan Assyaidis Syarif Hasyim, ketika hubungan Siak dengan pemerintah Hindia Belanda cukup dekat. Karena itu bangunan ini bisa dibaca sebagai pernyataan politik lewat arsitektur, bukan hanya sebagai tempat tinggal sultan.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">dibangun masa Sultan Assyaidis Syarif Hasyim</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Siak Sri Indrapura</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">batu, kaca, dan kayu</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-istana-siak/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Koleksi kebesaran kesultanan</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang-ruang istana dipakai memamerkan benda dan perlengkapan kebesaran kesultanan. Salah satu yang paling menonjol adalah kursi singgasana berlapis emas, yang dipajang dalam lemari kaca dengan label namanya. Singgasana adalah pusat upacara kerajaan: di sinilah sultan menerima pembesar dan tamu, sehingga posisinya dalam tata ruang istana menandai hierarki kekuasaan. Dengan mempertahankan benda di ruang aslinya, museum membuat pengunjung bisa membaca arti sebuah benda dari letaknya, bukan hanya dari keterangannya.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa Kesultanan Siak</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Istana Siak Sri Indrapura</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">logam berlapis emas, kain, dan kayu</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-istana-siak/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Arsip foto Sultan Siak</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Foto studio Sultan Siak dalam busana kebesaran berasal dari arsip kolonial awal abad ke-20. Potret semacam ini biasanya dibuat untuk kepentingan administrasi kolonial sekaligus sebagai penanda hubungan antara kesultanan dan pemerintah Hindia Belanda. Posisi duduk, pakaian, dan latar foto semuanya dipilih untuk menyampaikan wibawa. Bagi museum, arsip ini penting karena banyak bangunan dan upacara istana tidak lagi dapat disaksikan, sehingga foto menjadi satu-satunya gambaran yang tersisa.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">awal abad ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Koleksi arsip kolonial</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">foto studio</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-istana-siak/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikimedia Commons: Istana Siak</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File:Museum_siak_01.jpg</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman">
        <rdfs:label xml:lang="id">Museum Adityawarman</rdfs:label>
        <sdp:description xml:lang="id">Museum provinsi Sumatera Barat dengan atap bergonjong menyerupai rumah gadang. Koleksinya mencakup ukiran Minangkabau, kain songket, dan dokumen sejarah alam.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/sumatera-barat"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/padang"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/4"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/seni-budaya"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kemerdekaan"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1950</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Diponegoro No. 10, Padang</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-0.9471</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.3547</sdp:longitude>
        <sdp:history xml:lang="id">Museum Adityawarman diresmikan pada 16 Maret 1977 oleh Menteri Pendidikan dan Kebudayaan Syarif Thayeb, setelah konstruksinya dikerjakan sejak tahun anggaran 1974/1975. Namanya diambil dari Adityawarman, raja Malayapura abad ke-14 yang sezaman dengan Majapahit.

Museum ini berdiri di kompleks Lapangan Tugu, Jalan Diponegoro, Padang, di atas tanah seluas 2,5 hektar. Lokasi itu dahulu dikenal sebagai Taman Melati, tempat bermain warga kota. Setelah otonomi daerah, pengelolaannya berada di bawah Pemerintah Provinsi Sumatera Barat.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/exhibit/4"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/exhibit/5"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/source/1"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#StateMuseum"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-adityawarman/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-adityawarman/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Gedung utama museum</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Atap bergonjong berjumlah banyak ini mengadaptasi bentuk rumah gadang Minangkabau ke skala bangunan pameran. Museum Adityawarman dibangun sejak tahun anggaran 1974/1975 dan diresmikan 16 Maret 1977 oleh Menteri Pendidikan dan Kebudayaan Syarif Thayeb, di atas tanah 2,5 hektar bekas Taman Melati.</sdp:imageBackground>
        <sdp:imageAlt xml:lang="id">Museum Adityawarman — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">One of the museums that stores a collection of local and national culture with the architecture of the great Minangkabau traditional house called Rumah Gadang which is located in t</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Rieulraitday</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AMuseum_Adityawarman.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/1/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/1/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/1/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/1/detail/4"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/1/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Gedung utama ini menampung koleksi Sumatera Barat di Jalan Diponegoro, Padang.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/1/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Museum mengambil nama Adityawarman, raja Malayapura pada abad ke-14.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/1/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Di depannya berdiri rumah gadang, sehingga bangunan modern dan rumah adat terlihat sekaligus.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/1/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Fungsinya sebagai museum negeri provinsi dan pusat penelitian kebudayaan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-adityawarman/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Sudut bangunan museum</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Detail gonjong dan dinding berukir ini memperlihatkan bahwa museum bukan hanya tempat menyimpan koleksi, tetapi juga contoh arsitektur. Nama Adityawarman sendiri diambil dari raja Malayapura abad ke-14, masa ketika pengaruh Minangkabau dan Majapahit bertemu di Sumatera bagian tengah.</sdp:imageBackground>
        <sdp:imageAlt xml:lang="id">Museum Adityawarman — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Museum Adityawarman</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Rhmtdns</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AMuseum_Adityawarman_20211213.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/2/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/2/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/2/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/2/detail/4"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/2/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Sudut bangunan memperlihatkan atap dan dinding yang memakai bentuk rumah adat Minangkabau.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/2/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Atap melengkung seperti tanduk kerbau adalah ciri yang membedakannya dari rumah adat lain.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/2/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Bangunan panggung menyisakan ruang di bawah lantai untuk menghindari kelembapan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/2/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Pilihan bentuk ini membuat museum tampil sebagai bagian kebudayaan, bukan gedung asing.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/3">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-adityawarman/3.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Rumah gadang dan rangkiang</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Di halaman museum berdiri rumah gadang lengkap dengan rangkiang, lumbung padi beratap gonjong. Kehadirannya membuat museum dijuluki “Taman Mini ala Sumatera Barat”: pengunjung bisa melihat bangunan adat secara utuh, bukan hanya foto atau maketnya.</sdp:imageBackground>
        <sdp:imageAlt xml:lang="id">Museum Adityawarman — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Halaman Rumah Jo Rangkiang Rumah Gadang di Museum Adityawarman Kota Padang dari samping Kiri</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">DwiFidratul</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3ARangkiang_Rumah_Gadang_di_Museum_Adityawarman_Kota_Padang.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/3/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/3/detail/2"/>
