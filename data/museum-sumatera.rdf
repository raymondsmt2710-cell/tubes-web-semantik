        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-sultan-mahmud-badaruddin-ii/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-sultan-mahmud-badaruddin-ii/image/3"/>
