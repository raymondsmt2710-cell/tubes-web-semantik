    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien">
        <rdfs:label xml:lang="id">Museum Cut Nyak Dhien</rdfs:label>
        <sdp:description xml:lang="id">Menempati rumah panggung tempat Cut Nyak Dhien ditangkap pada 1905. Ruang pamer menyimpan replika pakaian, senjata, dan diorama yang mengisahkan perjuangan Aceh melawan kolonial.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/aceh"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/aceh-besar"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/1"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/perjuangan"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:address xml:lang="id">Lam Pisang, Aceh Besar</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.3878</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">95.4729</sdp:longitude>
        <sdp:history xml:lang="id">Museum Cut Nyak Dhien menempati rumah tradisional Aceh di Gampong Lampisang, Kecamatan Peukan Bada, Aceh Besar. Rumah ini adalah kediaman Cut Nyak Dhien (lahir 1848), pejuang yang memimpin perlawanan terhadap Belanda setelah suaminya, Teuku Umar, gugur pada 1899.

Rumah aslinya dibakar Belanda pada 1896; yang tersisa hanya pondasi. Bangunan yang berdiri sekarang adalah hasil pemugaran pada 1981, sedangkan peresmiannya sebagai museum dilakukan pada 1987 oleh Menteri Pendidikan dan Kebudayaan Fuad Hassan.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/4"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/exhibit/5"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/source/1"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-cut-nyak-dhien/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-cut-nyak-dhien/1.jpg</sdp:imageUrl>
        <sdp:imageAlt xml:lang="id">Museum Cut Nyak Dhien — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Reproduction negative(?). Cut Nyak Dhien (1848-1908) was the wife of Teuku Umar (1840-1899). After his death, she continued the struggle against the Dutch in Aceh, was taken prison</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Unknown author Unknown author</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 3.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/3.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3ACOLLECTIE_TROPENMUSEUM_Groepsportret_met_Cut_Nyak_Dhien_de_vrouw_van_Teuku_Umar_na_haar_gevangenneming_TMnr_10018822.jpg</sdp:imageSource>
    </sdp:Image>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-cut-nyak-dhien/2.jpg</sdp:imageUrl>
        <sdp:imageAlt xml:lang="id">Museum Cut Nyak Dhien — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">The Museum Cut Nyak Dhien is located in Lampisang, Aceh, Indonesia in a replica of the house where Teuku Umar and Cut Nyak Dhien once lived.</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Andrimubarak</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 3.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/3.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AMuseum_Cut_Nyak_Dhien.jpg</sdp:imageSource>
    </sdp:Image>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien/image/3">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:imageIndex>
