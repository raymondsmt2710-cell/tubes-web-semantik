    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman">
        <rdfs:label xml:lang="id">Museum Adityawarman</rdfs:label>
        <sdp:description xml:lang="id">Museum provinsi Sumatera Barat dengan atap bergonjong menyerupai rumah gadang. Koleksinya mencakup ukiran Minangkabau, kain songket, dan dokumen sejarah alam.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/sumatera-barat"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/padang"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/4"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/seni-budaya"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kemerdekaan"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1950</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Diponegoro No. 10, Padang</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-0.9471</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.3547</sdp:longitude>
        <sdp:history xml:lang="id">Museum Adityawarman diresmikan pada 16 Maret 1977 oleh Menteri Pendidikan dan Kebudayaan Syarif Thayeb, setelah konstruksinya dikerjakan sejak tahun anggaran 1974/1975. Namanya diambil dari Adityawarman, raja Malayapura abad ke-14 yang sezaman dengan Majapahit.

Museum ini berdiri di kompleks Lapangan Tugu, Jalan Diponegoro, Padang, di atas tanah seluas 2,5 hektar. Lokasi itu dahulu dikenal sebagai Taman Melati, tempat bermain warga kota. Setelah otonomi daerah, pengelolaannya berada di bawah Pemerintah Provinsi Sumatera Barat.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/exhibit/1"/>
