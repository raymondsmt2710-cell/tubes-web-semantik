    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/1/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Fungsinya sebagai museum provinsi sekaligus pusat penelitian kebudayaan daerah.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-sumatera-selatan/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Replika Rumah Limas</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Replika rumah limas ini dibangun di halaman museum sebagai contoh rumah adat Sumatera Selatan. Rumah limas bertingkat dan berundak, mencerminkan struktur sosial masyarakat Palembang yang berlapis; replikanya memudahkan pengunjung memahami bentuk aslinya tanpa harus berkunjung ke permukiman.</sdp:imageBackground>
        <sdp:imageAlt xml:lang="id">Museum Negeri Sumatera Selatan Balaputra Dewa — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">The replica of Limas house, a South Sumatran traditional house that showed up in Balaputra Dewa Museum (South Sumatra Museum). Notably had to be appeared in IDR 10.000 from 2005 to</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Firzafp</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AReplica_of_Rumah_Limas%2C_South_Sumatra_(Balaputra_Dewa)_Museum_-_Sukarame%2C_Palembang%2C_SS_(18_January_2024).jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/2/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/2/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/2/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/2/detail/4"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/2/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Replika Rumah Limas ini berdiri di halaman museum sebagai pameran arsitektur.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/2/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Atapnya bertingkat seperti limas, dan jumlah tingkatnya menandai kedudukan pemilik rumah.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/2/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Bangunannya ditinggikan di atas tiang dengan ruang terbuka di bagian depan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/2/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Rumah limas menjadi simbol Sumatera Selatan dan dipakai pada lambang daerah.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Replika Rumah Limas</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Rumah Limas adalah rumah adat Sumatera Selatan yang dibangun sebagai pameran di halaman museum. Namanya berasal dari atapnya yang bertingkat seperti limas, dan luas bangunannya menandai kedudukan pemiliknya. Rumah ini ditinggikan di atas tiang, dengan ruang utama di bagian tengah dan ruang terbuka di depan. Karena yang berdiri di sini adalah replika, pengunjung memperoleh gambaran bentuk keseluruhan rumah tanpa harus mengunjungi kampung asalnya.</sdp:exhibitDescription>
        <sdp:exhibitOrigin xml:lang="id">Sumatera Selatan</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kayu dan atap genteng</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Arca Hindu-Buddha</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang ini memuat arca dari masa Sriwijaya dan periode klasik Sumatera bagian selatan. Palembang dan sekitarnya pernah menjadi pusat Sriwijaya, kerajaan maritim yang pengaruhnya terasa sampai Semenanjung Melayu. Banyak arca ditemukan tidak lengkap, sebagian mungkin pernah dipindahkan atau rusak jauh sebelum ditemukan kembali. Bagi museum, penjelasan mengenai lokasi penemuan sama pentingnya dengan bentuk arcanya, karena dari situ bisa diperkirakan bagaimana kawasan ini dihuni pada masa lampau.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa Sriwijaya dan periode klasik</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Sumatera bagian selatan</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">batu</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Tenun songket Palembang</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Songket adalah kain tenun bermotif yang dibuat dengan menyelipkan benang emas atau perak ke dalam kain. Di Palembang, songket dipakai pada upacara pernikahan dan acara adat, dan motifnya sering diberi nama seperti bungo pacik atau tampak maco. Karena pembuatannya memakan waktu lama, satu kain bisa menjadi barang warisan keluarga. Museum menampilkan beragam motif agar pengunjung melihat bahwa keragaman songket tidak hanya soal warna, tetapi juga nama dan makna tiap pola.</sdp:exhibitDescription>
        <sdp:exhibitOrigin xml:lang="id">Palembang</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kain sutra dan benang emas</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Materai Kesultanan Palembang</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Materai ini berasal dari Kesultanan Palembang Darussalam dan dipamerkan sebagai koleksi sejarah. Materai dipakai untuk mengesahkan surat dan perjanjian, sehingga keberadaannya menandai bahwa sebuah dokumen benar berasal dari kesultanan. Palembang pada masa itu adalah pusat perdagangan sungai yang penting, dan banyak kesepakatan dagang memerlukan pengesahan semacam ini. Bagi peneliti, bentuk dan tulisan pada materai membantu menentukan masa pemakaiannya.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa Kesultanan Palembang Darussalam</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kesultanan Palembang Darussalam</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">logam</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/exhibit/5">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Koleksi tekstil dan kerajinan</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Selain songket, museum menyimpan tekstil dan kerajinan lain dari Sumatera Selatan. Kerajinan seperti anyaman dan ukiran biasanya dikerjakan di rumah sebagai pekerjaan sampingan, menggunakan bahan yang tersedia di sekitar. Coraknya berbeda antara daerah rawa, pesisir, dan dataran tinggi, mengikuti bahan dan keperluan setempat. Koleksi semacam ini jarang menjadi pusat perhatian pengunjung, tetapi memberi gambaran paling dekat tentang kehidupan sehari-hari masyarakat.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-19 hingga ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Sumatera Selatan</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kain, rotan, dan kayu</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikimedia Commons: Balaputra Dewa Museum</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File:Replica_of_Rumah_Limas,_South_Sumatra_(Balaputra_Dewa)_Museum_-_Sukarame,_Palembang,_SS_(18_January_2024).jpg</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-mahmud-badaruddin-ii">
        <rdfs:label xml:lang="id">Museum Sultan Mahmud Badaruddin II</rdfs:label>
        <sdp:description xml:lang="id">Menempati bekas kediaman Sultan Mahmud Badaruddin II di tepi Sungai Musi. Koleksinya mencakup benda kerajaan Palembang, senjata, dan dokumentasi perlawanan terhadap kolonial.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/sumatera-selatan"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/palembang"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/6"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/perjuangan"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/seni-budaya"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:address xml:lang="id">Jl. Merdeka, Palembang</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-2.9917</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">104.7603</sdp:longitude>
        <sdp:history xml:lang="id">Museum Sultan Mahmud Badaruddin II di Palembang berdiri di kawasan bekas Benteng Kuto Lama atau Kuto Tengkuruk, yang dahulu menjadi lokasi istana tua Sultan Mahmud Badaruddin I (1724–1758). Istana itu dihancurkan pemerintah kolonial Inggris pada 7 Oktober 1823.

Di atas reruntuhannya dibangun gedung baru yang selesai pada 1824 dan dikenal sebagai Gedung Siput. Bangunan batu dua lantai yang berdiri sekarang memadukan gaya Eropa dengan arsitektur tropis Hindia; pada 1825 dipakai sebagai kantor residen kolonial, lalu pada masa Perang Dunia II menjadi markas militer Jepang. Setelah kemerdekaan sempat menjadi markas Kodam II/Sriwijaya, dan sejak 1984 difungsikan sebagai museum.</sdp:history>
