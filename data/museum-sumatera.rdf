        <sdp:detailText xml:lang="id">Ia meninggal di pengasingan dan tidak pernah kembali ke Palembang.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-mahmud-badaruddin-ii/image/2/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Lukisan seperti ini memperlihatkan sisi lain tokoh perang, yaitu kehidupan jauh dari negerinya.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-mahmud-badaruddin-ii/image/3">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-sultan-mahmud-badaruddin-ii/3.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Potret Sultan Mahmud Badaruddin II</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Potret ini bernuansa romantis, dengan sorban, jubah biru, dan kumis tebal. Sultan Mahmud Badaruddin II (memerintah 1803–1813 dan 1818–1821) dikenal memimpin perlawanan terhadap Belanda dan Inggris; namanya diabadikan sebagai nama museum sejak gedung ini dialihfungsikan pada 1984.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">awal abad ke-19</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Sultan Mahmud Badaruddin II — foto dari Wikimedia Commons</sdp:imageAlt>
