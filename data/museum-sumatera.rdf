        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File:Traditional_Bengkulu_cooking_utensils,_Bengkulu_Museum_2015-04-19_01.jpg</sdp:sourceUrl>
