    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Senjata Perang Padri</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Senjata yang dipakai Tuanku Imam Bonjol dan kaum Padri, sebagian berupa replika karena benda asli hilang atau dicuri.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Lukisan Tuanku Imam Bonjol</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Lukisan karya Jenderal Hoegeng Imam Santoso, Kepala Polisi Republik Indonesia 1968–1971.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Pakaian kebesaran ulama</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Kostum kebesaran yang pernah dipakai Tuanku Imam Bonjol dan tokoh lain pada masanya.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Lantai dua: perkakas dan uang kuno</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Peralatan dapur, uang kuno, keramik antik, serta gamelan dan gong berbagai ukuran.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/5">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Naskah kuno dan replika</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Sejumlah naskah lama; sebagian telah hilang sehingga digantikan replika oleh pengelola.</sdp:exhibitDescription>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikipedia: Museum Tuanku Imam Bonjol</sdp:sourceLabel>
