        <sdp:detailText xml:lang="id">Koleksinya mencakup peralatan tambang, model, dan dokumen perusahaan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/1/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Museum menempati bangunan yang dahulu berkaitan langsung dengan kegiatan penambangan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-timah-indonesia/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Museum Timah Indonesia Muntok</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Bangunan inilah bekas kantor pusat Pertambangan Timah Bangka (Bankatinwinning) yang dibangun 1915 dan sempat menjadi pusat pemerintahan Belanda di Bangka. Setelah diambil alih tentara Jepang dan terbengkalai, gedung dikonservasi PT Timah Tbk, lalu diresmikan menjadi museum pada 7 November 2013. Museum ini memiliki galeri tentang Kapal Vyner Brooke dan perawat Vivian Bullwinkel.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">bangunan masa kolonial</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Timah Indonesia — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Museum Timah Indonesia Muntok</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Cun Cun</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AMuseum_Timah_Indonesia_Muntok.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/2/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/2/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/2/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/2/detail/4"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/2/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Bangunan ini adalah Museum Timah Indonesia di Muntok.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/2/detail/2">
