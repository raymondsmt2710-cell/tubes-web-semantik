    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-huta-bolon-simanindo/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-huta-bolon-simanindo/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Tampak depan rumah adat</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Dari depan terlihat struktur rumah panggung dengan tiang penyangga dan ukiran pada bagian atap. Susunan huta (kampung) seperti ini sengaja dipertahankan agar pengunjung memahami rumah adat sebagai bagian dari tata ruang kampung, bukan bangunan tunggal yang berdiri sendiri.</sdp:imageBackground>
        <sdp:imageAlt xml:lang="id">Museum Huta Bolon Simanindo — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Tampak bangunan dari depan</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Nafisathallah</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
