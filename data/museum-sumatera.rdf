        <sdp:detailText xml:lang="id">Halaman ini mempertemukan bangunan museum dan rumah adat dalam satu kompleks.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/image/3/detail/2">
