    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/2/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Uang kertas lima ratus rupiah ini memuat tanda tangan bertuliskan “LIPPHARTODES”.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/2/detail/2">
