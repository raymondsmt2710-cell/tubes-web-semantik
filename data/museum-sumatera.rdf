        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-adityawarman/image/3/detail/4"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/3/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Rumah gadang berdiri di halaman museum dengan rangkiang atau lumbung padi di depannya.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/3/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Atapnya melengkung dan biasanya bertingkat menurut jumlah ruang di dalamnya.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/3/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Rumah ini menjadi milik keluarga besar matrilineal, diwariskan lewat garis ibu.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/image/3/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Rangkiang menandai bahwa kehidupan rumah gadang terikat pada pertanian.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Duplikat patung Bhairawa dan Amoghapasa</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Benda purbakala ini peninggalan Kerajaan Dharmasraya dan menjadi koleksi penting museum. Patung Bhairawa dan Amoghapasa termasuk temuan yang paling banyak dibicarakan karena menunjukkan pengaruh Hindu-Buddha di pedalaman Sumatera, jauh dari pusat kerajaan besar di Jawa. Yang dipamerkan di sini adalah duplikat, sementara sebagian temuan aslinya berada di museum lain atau masih di lokasi penemuan. Bagi pengunjung, duplikat tetap berguna karena bentuk dan ukurannya dibuat sepadan dengan aslinya.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa Kerajaan Dharmasraya, abad ke-13 hingga ke-14</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kerajaan Dharmasraya, hulu Batanghari</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">batu</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Rumah gadang dan rangkiang</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Bangunan berarsitektur Minang ini berdiri di halaman museum dan menjadikan kompleksnya semacam taman mini Sumatera Barat. Rumah gadang beratap melengkung seperti tanduk kerbau adalah rumah keluarga besar matrilineal, sedangkan rangkiang adalah lumbung padi yang berdiri di depannya. Letak rangkiang di halaman bukan sekadar penyimpanan, melainkan penanda bahwa rumah itu terhubung dengan pertanian. Dengan menghadirkan keduanya di halaman, museum menjelaskan hubungan antara bentuk rumah dan cara hidup masyarakatnya.</sdp:exhibitDescription>
        <sdp:exhibitOrigin xml:lang="id">Sumatera Barat</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kayu, bambu, dan atap ijuk</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Diorama adat matrilineal Minangkabau</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang utama ini menjelaskan sistem kekerabatan Minangkabau, peran perempuan, sampai tradisi pantun. Minangkabau menganut garis keturunan ibu, sehingga rumah, tanah, dan gelar adat diwariskan lewat perempuan. Diorama dipakai karena sistem seperti ini tidak bisa dijelaskan hanya dengan satu benda: yang ditampilkan adalah hubungan antarpihak dalam keluarga. Tradisi pantun juga mendapat tempat karena banyak aturan adat disampaikan lewat tutur, bukan dokumen tertulis.</sdp:exhibitDescription>
        <sdp:exhibitOrigin xml:lang="id">Sumatera Barat</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">diorama, panel, dan benda adat</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Ruang peragaan pelaminan</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Pelaminan pernikahan adat Minang ini menjadi salah satu ruang paling diminati pengunjung. Susunannya menampilkan kursi pengantin berhias, kain sulaman, dan ukiran yang dipakai pada acara pernikahan. Dalam adat Minang, pelaminan menandai perpindahan status pengantin dan menjadi titik upacara, bukan hanya latar foto. Karena warna dan hiasannya beragam menurut daerah, satu pelaminan bisa menjelaskan banyak tentang adat suatu nagari.</sdp:exhibitDescription>
        <sdp:exhibitOrigin xml:lang="id">Sumatera Barat</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kain sulaman, ukiran, dan perlengkapan upacara</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/exhibit/5">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Koleksi Suku Mentawai</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Benda budaya Mentawai ini ditampilkan berdampingan dengan koleksi Minangkabau. Kepulauan Mentawai berada di lepas pantai Sumatera Barat, tetapi kebudayaannya berbeda jauh dari Minangkabau: bahasanya berbeda, sistem kekerabatannya tidak matrilineal, dan banyak tradisinya berasal dari tradisi kepulauan yang lebih tua. Menempatkan keduanya dalam satu museum menunjukkan bahwa Sumatera Barat tidak tunggal. Karena itu ruang ini penting untuk memperlihatkan keragaman, bukan hanya kebudayaan mayoritas.</sdp:exhibitDescription>
        <sdp:exhibitOrigin xml:lang="id">Kepulauan Mentawai</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kayu, rotan, dan bahan alam</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-adityawarman/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikipedia: Museum Adityawarman</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://id.wikipedia.org/wiki/Museum_Adityawarman</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka">
        <rdfs:label xml:lang="id">Museum Rumah Kelahiran Buya Hamka</rdfs:label>
        <sdp:description xml:lang="id">Rumah kelahiran ulama dan sastrawan Hamka di tepi Danau Maninjau. Ruangannya memuat buku, foto, dan benda pribadi yang menandai jejak hidupnya.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/sumatera-barat"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/agam"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/4"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/seni-budaya"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:address xml:lang="id">Nagari Sungai Batang, Kabupaten Agam</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-0.3078</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.1147</sdp:longitude>
        <sdp:history xml:lang="id">Museum Rumah Kelahiran Buya Hamka berada di tepi Danau Maninjau, tepatnya di Nagari Sungai Batang, Kecamatan Tanjung Raya, Kabupaten Agam. Bangunannya adalah rumah yang ditempati Haji Abdul Malik Karim Amrullah sejak lahir hingga sebelum pindah ke Padang Panjang.

Rumah milik nenek Hamka itu hampir hancur pada masa pendudukan Jepang. Pada 2000 Gubernur Sumatera Barat Zainal Bakar menggagas pembangunannya kembali dengan bentuk asli, dan setelah 11 bulan pembangunan museum diresmikan pada 11 November 2001.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/image/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/exhibit/4"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/source/1"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#SiteMuseum"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-rumah-kelahiran-buya-hamka/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-rumah-kelahiran-buya-hamka/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-rumah-kelahiran-buya-hamka/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Rumah kelahiran Buya Hamka</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Rumah kayu beratap gonjong ini adalah rumah tempat Hamka lahir dan tinggal sebelum pindah ke Padang Panjang. Rumah milik neneknya hampir hancur pada masa pendudukan Jepang, lalu dibangun kembali dan diresmikan sebagai museum pada 11 November 2001 oleh Gubernur Zainal Bakar. Lokasinya di tepi Danau Maninjau.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">kelahiran 1908</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Rumah Kelahiran Buya Hamka — foto dari Wikimedia Commons</sdp:imageAlt>
