        <sdp:detailText xml:lang="id">Koleksi seperti ini dipakai untuk menelusuri perubahan nilai dan desain uang.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-bengkulu/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Uang kertas 500 rupiah bertanda LIPPHARTODES</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Pada lembar 500 rupiah ini tercetak cap “LIPPHARTODES PAPERIAH”. Cap semacam ini lazim dipakai pada masa peralihan mata uang, ketika lembar lama diperiksa dan ditandai sebelum tetap atau tidak tetap berlaku. Jejaknya membuat uang bukan hanya alat tukar, tetapi juga arsip administratif.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">sebelum pembaruan ejaan</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Negeri Bengkulu — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">10 rupiah (South Sumatra; obverse), Bengkulu Museum, 2015-04-19</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Crisco 1492</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">Public domain</sdp:imageLicense>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3A500_rupiah_(PMR_reverse)%2C_Bengkulu_Museum%2C_2015-04-19.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/2/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/2/detail/2"/>
