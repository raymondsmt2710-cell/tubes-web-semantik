    <!-- Instance museum -->

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-aceh">
        <rdfs:label xml:lang="id">Museum Negeri Aceh</rdfs:label>
        <sdp:description xml:lang="id">Museum tertua di Aceh yang menempati bekas gedung pameran kolonial dari awal abad ke-20. Koleksinya mencakup naskah, senjata tradisional, dan benda sehari-hari masyarakat Aceh, termasuk koleksi Rumoh Aceh di halaman belakang.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/aceh"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/banda-aceh"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/1"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/seni-budaya"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1915</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Sultan Mahmudsyah No. 12, Banda Aceh</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.5483</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">95.3238</sdp:longitude>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-tsunami-aceh">
        <rdfs:label xml:lang="id">Museum Tsunami Aceh</rdfs:label>
        <sdp:description xml:lang="id">Dibangun sebagai peringatan bencana tsunami 26 Desember 2004. Lorong masuknya berbentuk gelombang, dan ruang pamer berisi foto, benda peninggalan, serta kisah penyintas yang disusun sebagai ruang refleksi.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/aceh"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/banda-aceh"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/1"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/sejarah-alam"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/seni-budaya"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/modern"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2009</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Sultan Iskandar Muda, Banda Aceh</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.5476</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">95.3153</sdp:longitude>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-cut-nyak-dhien">
        <rdfs:label xml:lang="id">Museum Cut Nyak Dhien</rdfs:label>
        <sdp:description xml:lang="id">Menempati rumah panggung tempat Cut Nyak Dhien ditangkap pada 1905. Ruang pamer menyimpan replika pakaian, senjata, dan diorama yang mengisahkan perjuangan Aceh melawan kolonial.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/aceh"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/aceh-besar"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/1"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/perjuangan"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:address xml:lang="id">Lam Pisang, Aceh Besar</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.3878</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">95.4729</sdp:longitude>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-malikussaleh">
        <rdfs:label xml:lang="id">Museum Malikussaleh</rdfs:label>
        <sdp:description xml:lang="id">Berada di kawasan bekas Kerajaan Samudera Pasai, kerajaan Islam pertama di Nusantara. Koleksinya berupa fragmen batu nisan, mata uang kuno, dan temuan arkeologis dari situs sekitar.</sdp:description>
