<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:geo="http://www.w3.org/2003/01/geo/wgs84_pos#"
    xmlns:sdp="https://museumsumatera.id/ontology#"
    xmlns:res="https://museumsumatera.id/resource/">

    <!-- Kelas -->

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Museum">
        <rdfs:label xml:lang="id">Museum</rdfs:label>
        <rdfs:comment xml:lang="id">Sebuah museum di Pulau Sumatera.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Province">
        <rdfs:label xml:lang="id">Provinsi</rdfs:label>
        <rdfs:comment xml:lang="id">Provinsi di Pulau Sumatera.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#City">
        <rdfs:label xml:lang="id">Kota atau Kabupaten</rdfs:label>
        <rdfs:comment xml:lang="id">Lokasi kota atau kabupaten.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Theme">
        <rdfs:label xml:lang="id">Tema</rdfs:label>
        <rdfs:comment xml:lang="id">Tema koleksi museum.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Era">
        <rdfs:label xml:lang="id">Era</rdfs:label>
        <rdfs:comment xml:lang="id">Periode sejarah yang diwakili koleksi.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="https://museumsumatera.id/ontology#Chapter">
        <rdfs:label xml:lang="id">Bab</rdfs:label>
        <rdfs:comment xml:lang="id">Bab dalam alur pameran.</rdfs:comment>
    </owl:Class>

    <!-- Object property -->

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#locatedInProvince">
        <rdfs:label xml:lang="id">berlokasi di provinsi</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="https://museumsumatera.id/ontology#Province"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#locatedInCity">
        <rdfs:label xml:lang="id">berlokasi di kota</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="https://museumsumatera.id/ontology#City"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#partOfProvince">
        <rdfs:label xml:lang="id">bagian dari provinsi</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#City"/>
        <rdfs:range rdf:resource="https://museumsumatera.id/ontology#Province"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#hasTheme">
        <rdfs:label xml:lang="id">memiliki tema</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="https://museumsumatera.id/ontology#Theme"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#hasEra">
        <rdfs:label xml:lang="id">memiliki era</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="https://museumsumatera.id/ontology#Era"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://museumsumatera.id/ontology#chapter">
        <rdfs:label xml:lang="id">berada di bab</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="https://museumsumatera.id/ontology#Chapter"/>
    </owl:ObjectProperty>

    <!-- Datatype property -->

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#establishedYear">
        <rdfs:label xml:lang="id">tahun berdiri</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#description">
        <rdfs:label xml:lang="id">deskripsi</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#imageUrl">
        <rdfs:label xml:lang="id">tautan gambar</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#officialUrl">
        <rdfs:label xml:lang="id">situs resmi</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#address">
        <rdfs:label xml:lang="id">alamat</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#latitude">
        <rdfs:label xml:lang="id">lintang</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#longitude">
        <rdfs:label xml:lang="id">bujur</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#admissionNote">
        <rdfs:label xml:lang="id">catatan kunjungan</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#verificationStatus">
        <rdfs:label xml:lang="id">status verifikasi data</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#chapterIndex">
        <rdfs:label xml:lang="id">urutan bab</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Chapter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

