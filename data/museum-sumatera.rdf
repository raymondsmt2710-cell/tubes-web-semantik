        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-malikussaleh/image/3/detail/4"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-malikussaleh/image/3/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Koin emas bertulisan Arab ini adalah mata uang kesultanan Samudera Pasai.</sdp:detailText>
    </sdp:ImageDetail>

