    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-linggam-cahaya">
        <rdfs:label xml:lang="id">Museum Linggam Cahaya</rdfs:label>
        <sdp:description xml:lang="id">Museum daerah di bekas pusat Kesultanan Lingga yang menyimpan koleksi kerajaan Melayu, termasuk naskah, alat musik, dan peninggalan masa kejayaan Lingga.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/kepulauan-riau"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/lingga"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/3"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/arkeologi"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:address xml:lang="id">Daik, Kabupaten Lingga</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-0.2079</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">104.6169</sdp:longitude>
        <sdp:history xml:lang="id">Museum Linggam Cahaya berdiri di Kompleks Istana Damnah, Jalan Raja Muhammad Yusuf, Daik, Kabupaten Lingga. Namanya berasal dari kata “linggam” (batu berwarna merah) dan “cahaya”, sehingga berarti “batu merah yang bersinar”.

Pendiriannya berawal dari upaya menyelamatkan benda bersejarah Lingga. Pembangunan museum mini dimulai Agustus 2002 sebagai bagian proyek Dinas Kebudayaan, Seni, dan Pariwisata Provinsi Kepulauan Riau dan selesai 7 Mei 2003. Museum kemudian diresmikan dan mulai beroperasi pada 1 Maret 2015.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-linggam-cahaya/image/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-linggam-cahaya/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-linggam-cahaya/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-linggam-cahaya/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-linggam-cahaya/exhibit/4"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-linggam-cahaya/source/1"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-linggam-cahaya/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-linggam-cahaya/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-linggam-cahaya/1.jpg</sdp:imageUrl>
