        <sdp:detailText xml:lang="id">Jendela dan pintunya besar agar udara masuk, ciri bangunan di daerah panas.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/3/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Posisinya di jalan utama memudahkan pengawasan pada masa pengasingan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/3/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Dari sisi ini pengunjung biasanya masuk sebelum melihat perabot di dalam.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Rumah masa pengasingan</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Bangunan asli ini menjadi tempat tinggal Soekarno selama diasingkan di Bengkulu. Ia diasingkan ke sini pada 1938 setelah sebelumnya dibuang ke Flores, dan tinggal sampai 1942 ketika Jepang masuk. Rumahnya sederhana dan tidak besar, sehingga pengunjung bisa membayangkan bahwa pengasingan berlangsung dalam kehidupan yang sangat terbatas. Meski begitu, selama di Bengkulu Soekarno tetap aktif menulis dan mengajar, sehingga masa pengasingan bukan masa berhentinya kegiatan politik.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">1938–1942</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Bengkulu</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kayu dan beton</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Perabot dan benda pribadi</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang ini memuat perlengkapan rumah tangga yang dipakai pada masa pengasingan. Perabotnya menunjukkan standar hidup yang sederhana, jauh dari kesan istana yang sering dibayangkan orang tentang seorang tokoh nasional. Beberapa benda berkaitan dengan kegiatan sehari-hari seperti membaca, menulis, dan menerima tamu. Dengan mempertahankan perabot aslinya, museum memilih menampilkan kehidupan rumah, bukan sekadar benda bersejarah, sehingga masa pengasingan terasa lebih nyata.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa pengasingan</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Rumah pengasingan Bengkulu</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kayu, kain, dan logam</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Dokumentasi periode 1938–1942</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Catatan dan foto di ruang ini menguraikan kegiatan Soekarno selama berada di Bengkulu. Selama periode itu ia aktif dalam kegiatan keagamaan dan pendidikan, termasuk mengajar dan bergaul dengan tokoh setempat. Dokumentasi semacam ini penting karena masa pengasingan sering hanya dikenang sebagai hukuman, padahal di situlah beberapa gagasannya berkembang. Bagi Bengkulu sendiri, periode ini meninggalkan jejak pada kehidupan organisasi dan pendidikan di kota tersebut.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">1938–1942</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Arsip kolonial dan dokumentasi keluarga</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">foto dan catatan</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikipedia: Rumah Pengasingan Bung Karno</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://id.wikipedia.org/wiki/Rumah_Pengasingan_Bung_Karno</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan">
        <rdfs:label xml:lang="id">Museum Negeri Sumatera Selatan Balaputra Dewa</rdfs:label>
        <sdp:description xml:lang="id">Museum provinsi Sumatera Selatan dengan koleksi arca Hindu-Buddha, keramik, dan tenun songket Palembang. Namanya diambil dari raja Sriwijaya, Balaputra Dewa.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/sumatera-selatan"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/palembang"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/6"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/arkeologi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kemerdekaan"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1978</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Srijaya Negara, Palembang</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-2.9761</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">104.7353</sdp:longitude>
        <sdp:history xml:lang="id">Museum Negeri Sumatera Selatan Balaputra Dewa berada di Jalan Srijaya Negara, Palembang. Namanya diambil dari Balaputra Dewa, raja Sriwijaya, dan bangunannya dikenal sebagai bekas Burgemeesterhuis atau rumah wali kota Palembang pada masa kolonial.

Museum ini menyimpan koleksi arca Hindu-Buddha, keramik, tekstil, serta tenun songket Palembang, dan menjadi rujukan utama sejarah Sumatera Selatan.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/exhibit/4"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/exhibit/5"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/source/1"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#StateMuseum"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-sumatera-selatan/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-sumatera-selatan/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Bangunan museum dan halaman</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Gedung ini dikenal sebagai Burgemeesterhuis — rumah wali kota Palembang pada masa kolonial — sebelum menjadi Museum Negeri Sumatera Selatan Balaputra Dewa. Namanya diambil dari Balaputra Dewa, raja Sriwijaya, dan koleksinya mencakup arca Hindu-Buddha, keramik, serta tenun songket Palembang.</sdp:imageBackground>
        <sdp:imageAlt xml:lang="id">Museum Negeri Sumatera Selatan Balaputra Dewa — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Also known as Burgemeesterhuis in de Gemeente Palembang (Palembang Municipality Mayor House) during Dutch colonial era, this is textile museum located in Talang Semut, Bukit Kecil,</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Firzafp</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3ATextile_Museum_of_South_Sumatra_-_Bukit_Kecil%2C_Palembang%2C_SS.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/1/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/1/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/1/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/1/detail/4"/>
    </sdp:Image>

