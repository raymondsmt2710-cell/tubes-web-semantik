    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-taman-purbakala-sriwijaya/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Pendopo utama</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Pendopo Beratap limasan ini menjadi pusat kegiatan di taman purbakala, dipakai untuk pertemuan dan pameran. Kehadirannya menjadikan kawasan ini museum terbuka: pengunjung belajar dari struktur bata kuno yang dibiarkan di tempatnya, bukan hanya dari benda di dalam lemari kaca.</sdp:imageBackground>
        <sdp:imageAlt xml:lang="id">Museum Taman Purbakala Kerajaan Sriwijaya — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Main pavilion in Limasan house traditional architecture. Srivijaya Archaeological Park, Palembang, South Sumatra, Indonesia. The main pavilion host the replica of Kedukan Bukit ins</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Gunawan Kartapranata</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 3.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/3.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3ATaman_Purbakala_Kerajaan_Sriwijaya_-_Pendopo_Utama.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/2/detail/1"/>
