    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-mahmud-badaruddin-ii/image/2/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Lukisan ini menggambarkan Sultan Mahmud Badaruddin II semasa diasingkan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-mahmud-badaruddin-ii/image/2/detail/2">
