    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Lokomotif uap bergigi E1060</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ini adalah satu-satunya lokomotif uap di museum, dirancang untuk jalur curam Kayu Tanam–Batu Tabal dan Padang Panjang–Bukittinggi. Lokomotif bergigi memakai roda bergerigi yang mencengkeram rel khusus agar tidak meluncur mundur di tanjakan tajam. Teknologi ini dipilih karena jalur kereta di Sumatera Barat melewati perbukitan yang sulit dilalui lokomotif biasa. Bagi pengunjung, lokomotif ini menjelaskan bahwa pengangkutan batu bara dari Sawahlunto bergantung pada rekayasa yang dirancang khusus untuk medan setempat.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">akhir abad ke-19</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Jalur Kayu Tanam–Batu Tabal dan Padang Panjang–Bukittinggi</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">baja</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Gerbong dan miniatur lokomotif</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Museum memuat lima gerbong dan sembilan miniatur lokomotif dari total 106 koleksi. Gerbong mengangkut batu bara dari tambang menuju pelabuhan, sehingga ukuran dan bentuknya disesuaikan dengan muatan berat. Miniatur dipakai karena tidak semua jenis lokomotif yang pernah beroperasi bisa dipertahankan dalam ukuran asli. Dengan menampilkan keduanya, museum memperlihatkan bahwa jalur ini memakai beberapa jenis kendaraan yang berbeda sesuai kebutuhan.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa operasi tambang</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Jalur kereta batu bara Sawahlunto</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">baja dan kayu</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Peralatan sinyal dan komunikasi</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Tiga puluh empat alat sinyal dan komunikasi kereta api masih dipamerkan di ruang stasiun. Sebelum ada radio, keselamatan jalur bergantung pada sinyal mekanik dan telegraf yang menghubungkan stasiun satu dengan lainnya. Kesalahan kecil dalam urutan sinyal bisa berakibat tabrakan, sehingga peralatan ini dirawat dengan aturan ketat. Melihat alat-alatnya membantu pengunjung memahami bahwa kerja perkeretaapian adalah kerja koordinasi, bukan hanya mengemudikan lokomotif.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-19 hingga ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Stasiun dan jalur kereta Sawahlunto</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">logam, kayu, dan kaca</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Dokumentasi foto perkeretaapian</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Tiga puluh empat foto dokumentasi ini merekam masa operasi jalur kereta batu bara Sawahlunto. Foto-foto itu memperlihatkan stasiun, lokomotif, dan pekerja yang menjalankan jalur setiap hari. Sawahlunto tumbuh sebagai kota tambang karena kereta inilah yang mengangkut hasil tambang ke pelabuhan, sehingga foto-foto tersebut sekaligus menjadi sejarah kota. Banyak bangunan yang tampak dalam foto sudah berubah, menjadikan arsip ini rujukan penting untuk memahami tata kota lama.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">akhir abad ke-19 hingga ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Arsip perkeretaapian Sawahlunto</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">foto</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikipedia: Museum Kereta Api Sawahlunto</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://id.wikipedia.org/wiki/Museum_Kereta_Api_Sawahlunto</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-jambi">
        <rdfs:label xml:lang="id">Museum Negeri Jambi</rdfs:label>
        <sdp:description xml:lang="id">Menyimpan koleksi budaya Melayu Jambi dan temuan dari kawasan Batanghari, termasuk arca dan benda megalitik. Bangunannya berarsitektur rumah panggung dengan ornamen khas.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/jambi"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/jambi"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/5"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/arkeologi"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kemerdekaan"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1986</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Urip Sumoharjo, Jambi</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-1.6101</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">103.6131</sdp:longitude>
        <sdp:history xml:lang="id">Museum Negeri Jambi berdiri di Jalan Urip Sumoharjo, kawasan Sungai Putri, Telanaipura, Kota Jambi. Museum ini dibangun pada 18 Februari 1981 dan diresmikan pada 6 Juni 1988 oleh Menteri Pendidikan dan Kebudayaan Fuad Hassan, lalu dikenal sebagai Museum Siginjei.

Koleksinya mencakup keramik, arca, dan benda upacara masyarakat Jambi. Sejak museum di Jalan Prof. Dr. Sri Soedewi beroperasi, penamaan Museum Siginjai dipakai untuk museum provinsi Jambi, sehingga kedua entri dalam katalog ini merujuk pada tradisi permuseuman yang sama.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-jambi/image/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-jambi/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-jambi/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-jambi/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-jambi/exhibit/4"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-jambi/source/1"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-jambi/source/2"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#StateMuseum"/>
        <sdp:relatedMuseum rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-jambi/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-jambi/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-jambi/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Museum Siginjei dari arah Danau Sipin</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Museum Siginjei — dulu bernama Museum Negeri Provinsi Jambi — berdiri di Jalan Urip Sumoharjo, kawasan Sungai Putri, Telanaipura. Gedungnya diresmikan 6 Juni 1988 oleh Menteri Pendidikan dan Kebudayaan Fuad Hassan setelah dibangun sejak 18 Februari 1981.</sdp:imageBackground>
        <sdp:imageAlt xml:lang="id">Museum Negeri Jambi — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Museum Siginjei</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Firzafp</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AMuseum_Siginjei_-_Danau_Sipin%2C_Kota_Jambi%2C_JA_(8_Jan_&apos;25).jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-jambi/image/1/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-jambi/image/1/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-jambi/image/1/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-jambi/image/1/detail/4"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-jambi/image/1/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Foto ini memperlihatkan Museum Siginjei dari arah Danau Sipin.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-jambi/image/1/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Bentuk bangunannya mengacu pada rumah panggung Kayu Tinggi, rumah tradisional Jambi.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-jambi/image/1/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Ornamen khas Jambi menjadi ciri yang membedakannya dari bangunan provinsi lain.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-jambi/image/1/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Letaknya di tepi danau membuat bangunan mudah dikenali dari kejauhan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-jambi/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Bangunan berarsitektur rumah panggung</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Gedung museum ini memakai ornamen khas Jambi yang menjadi ciri bangunan provinsi. Bentuknya mengacu pada rumah panggung Kayu Tinggi, rumah tradisional Jambi yang ditinggikan di atas tiang. Pilihan bentuk itu membuat museum tampil sebagai bagian kebudayaan setempat, bukan gedung asing di tengah kota. Letaknya di tepi Danau Sipin juga menjadikannya mudah dikenali dari arah danau, dan pada pagi hari pantulan air membuat bangunannya terlihat utuh dari seberang.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">dibangun era 1980-an</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kota Jambi, tepi Danau Sipin</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kayu dan beton beratap bentuk rumah Jambi</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-jambi/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Koleksi Batanghari</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang ini memuat arca dan benda megalitik dari kawasan hulu Sungai Batanghari. Sungai Batanghari adalah jalur utama yang menghubungkan pedalaman Sumatera dengan pesisir timur, sehingga banyak temuan arkeologis tersebar di sepanjang alirannya. Benda megalitik menunjukkan kepercayaan lama yang mendahului masuknya Hindu-Buddha dan Islam. Karena temuan di hulu sungai lebih sulit dijangkau, koleksi museum ini menjadi rujukan penting bagi pengunjung yang tidak dapat mendatangi situs aslinya.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa megalitik hingga masa klasik</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kawasan hulu Sungai Batanghari</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">batu dan logam</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-jambi/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Budaya Melayu Jambi</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang ini memuat benda upacara dan perlengkapan adat masyarakat Melayu Jambi. Kebudayaan Melayu Jambi terbentuk dari campuran pengaruh kesultanan, perdagangan sungai, dan tradisi pedalaman, sehingga bentuk upacaranya pun berbeda dari Melayu pesisir. Benda seperti kain dan perlengkapan upacara biasanya dipakai pada peristiwa tertentu, bukan sehari-hari. Karena itu museum menjelaskan kapan dan oleh siapa benda itu dipakai, agar pengunjung tidak menyimpulkan bahwa semuanya dipakai bersamaan.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa Kesultanan Jambi hingga kini</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Masyarakat Melayu Jambi</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kain, kayu, dan logam</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-jambi/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Arca dan temuan hulu Batanghari</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Arca-arca dari hulu Batanghari memperlihatkan pengaruh Hindu-Buddha yang masuk lewat jalur sungai, bukan hanya lewat pesisir. Kawasan hulu Batanghari dikenal sebagai salah satu tempat asal temuan penting yang kemudian tersebar ke berbagai museum, sebagian bahkan dibawa ke luar negeri pada masa kolonial. Bagi museum daerah, menampilkan arca semacam ini berarti mempertahankan hubungan antara benda dan tempat asalnya. Keterangan mengenai lokasi penemuan menjadi bagian penting dari penjelasannya.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa klasik Sumatera</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Hulu Sungai Batanghari</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">batu</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-jambi/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikimedia Commons: Museum Siginjei</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File:Museum_Siginjei.png</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-jambi/source/2">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Museum.co.id: Museum Siginjai Jambi</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://museum.co.id/directory-museum/listing/museum-siginjai-jamb/</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai">
        <rdfs:label xml:lang="id">Museum Siginjai</rdfs:label>
        <sdp:description xml:lang="id">Museum yang mengangkat nama siginjai, ikat pinggang pusaka raja Jambi. Koleksinya mencakup keramik Cina, arca, dan benda upacara masyarakat Jambi.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/jambi"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/jambi"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/5"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/arkeologi"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kemerdekaan"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1988</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Prof. Dr. Sri Soedewi, Jambi</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-1.6044</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">103.5811</sdp:longitude>
        <sdp:history xml:lang="id">Museum Siginjai dibangun pada 18 Februari 1981 oleh Gubernur Jambi Masjchun Syofwan dan diresmikan pada 6 Juni 1988 oleh Menteri Pendidikan dan Kebudayaan Fuad Hassan. Awalnya museum ini bernama Museum Negeri Jambi, dan kini dikenal juga sebagai Museum Siginjei.

Namanya merujuk siginjai, ikat pinggang pusaka raja Jambi. Museum berdiri di Jalan Jenderal Urip Sumoharjo, kawasan Sungai Putri, Telanaipura, Kota Jambi, dan menyimpan ribuan koleksi budaya Melayu Jambi.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/4"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/exhibit/5"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/source/1"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/source/2"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#StateMuseum"/>
        <sdp:relatedMuseum rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-jambi"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-siginjai/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-siginjai/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Panel Residen Pertama Djambi</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Panel ini mencatat bahwa Dr. Syagaf Yahya diangkat sebagai Residen Djambi pada 3 September 1945, lalu digantikan Raden Inukertapati, salah satu pertimbangannya karena ia putra Sultan Thaha Saifuddin. Di bawahnya dipasang dokumen Kongres Rakyat Djambi dan foto-foto kongres itu — bukti bagaimana museum menyusun sejarah pemerintahan dari arsip.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">masa kolonial</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Siginjai — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Residen Pertama Djambi Kantor Residen Djambi dibangun oleh Kolonial Belanda (1928) Sekarang Kantor Satuan Brimob Polda Jambi Pada tanggal 3 September 1945, Dr. Syagaf Yahya diangka</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Muhamad Izzul Fiqih</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AKoleksi_Poster_Residen_Pertama_Jambi.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/image/1/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/image/1/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/image/1/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/image/1/detail/4"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/1/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Panel ini memuat keterangan tentang Residen Pertama Djambi pada masa kolonial.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/1/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Residen adalah pejabat Belanda yang memimpin wilayah karesidenan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/1/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Panel semacam ini menjadi bagian koleksi karena merekam struktur pemerintahan kolonial.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/1/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Ejaan “Djambi” menunjukkan dokumen berasal dari masa sebelum ejaan diperbarui.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-siginjai/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Instalasi Kilang Avigas</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Instalasi pipa dan tabung berwarna krem ini diberi label “Kilang Avigas — Sumber Energi”. Benda semacam ini menunjukkan bahwa perjuangan kemerdekaan juga berlangsung lewat penguasaan sumber energi dan infrastruktur, bukan hanya pertempuran bersenjata.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">abad ke-20</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Siginjai — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Suatu Kenangan Bukti Nyata Masyarakat Jambi Dalam Mendukung Kemerdekaan 17 Agustus 1945 Sei Bahar, April 1994 Pertamina Unit EP Lap. Jambi Kepala, (Tanda tangan) Yusri Dahar --- KI</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Muhamad Izzul Fiqih</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AKILANG_AVIGAS_Diusahakan_Perusahaan_Minyak_RI_Jambi.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/image/2/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/image/2/detail/2"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/image/2/detail/3"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-siginjai/image/2/detail/4"/>
    </sdp:Image>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/2/detail/1">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Instalasi ini berkaitan dengan Kilang Avigas yang pernah beroperasi di kawasan Jambi.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/2/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Benda industri seperti ini jarang menjadi koleksi museum daerah.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/2/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Kehadirannya menunjukkan sejarah Jambi juga mencakup masa usaha dan industri.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/2/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Peralatan logam dan pipa menandakan pengolahan bahan bakar, bukan benda rumah tangga.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-siginjai/image/3">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-siginjai/3.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Stempel Dewan Patih Kesultanan Jambi</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Stempel ini pernah dipakai Said Idrus bin Hasan Al Jupri bergelar Pangeran Wiro Kusumo. Cap semacam ini menjadi bukti tertulis berjalannya administrasi kesultanan Jambi, sekaligus menunjukkan bagaimana kekuasaan didelegasikan kepada pejabat di bawah sultan.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">masa Kesultanan Jambi</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Siginjai — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">STEMPEL Benda ini pernah dipakai oleh Said Idrus bin Hasan Al Jupri bergelar Pangeran Wiro Kusumo. Beliau salah seorang Dewan Patih Dalam Kesultanan Jambi. STAMP This stamp was use</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Muhamad Izzul Fiqih</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AStempel_Dewan_Patih_Kesultanan_Jambi.jpg</sdp:imageSource>
