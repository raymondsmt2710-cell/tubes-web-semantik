        <sdp:detailText xml:lang="id">Makam sultan tersebut menjadi salah satu situs utama di dalam kawasan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-malikussaleh/image/3">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-malikussaleh/3.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Koin emas Samudera Pasai</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Koin emas bertulisan Arab ini adalah mata uang kesultanan Samudera Pasai. Keberadaan mata uang sendiri menunjukkan kerajaan ini sudah memiliki sistem ekonomi dan administrasi yang mapan pada abad ke-13 hingga ke-14, sezaman dengan masa kejayaan jalur dagang Selat Malaka.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">abad ke-13 hingga ke-14</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Malikussaleh — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Koin Kesultanan Samudera Pasai, berbahan timah, pada masa Sultan Mukmin.</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Original: Unknown, photograph: Rachmat04</sdp:imageCredit>
        <sdp:imageLicense xml:lang="id">CC BY-SA 4.0</sdp:imageLicense>
        <sdp:imageLicenseUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by-sa/4.0</sdp:imageLicenseUrl>
        <sdp:imageSource rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File%3AMUS_Koin_Kesultanan_Samudera_Pasai%3B_1.jpg</sdp:imageSource>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-malikussaleh/image/3/detail/1"/>
        <sdp:imageDetail rdf:resource="https://museumsumatera.id/resource/museum/museum-malikussaleh/image/3/detail/2"/>
