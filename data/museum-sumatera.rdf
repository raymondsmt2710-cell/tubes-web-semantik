    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-tsunami-aceh/image/2">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-tsunami-aceh/2.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Miniatur masjid yang runtuh</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Maket masjid berkubah yang sebagian blok bangunannya menonjol keluar dari dinding lantai, dikelilingi serakan kayu dan puing, menggambarkan dahsyatnya hantaman gelombang 26 Desember 2004. Banyak masjid di pesisir Aceh hancur atau berdiri miring oleh gelombang itu, dan bangunan yang selamat seperti Masjid Baiturrahman kemudian menjadi titik berkumpul penyintas.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">peristiwa 26 Desember 2004</sdp:imagePeriod>
