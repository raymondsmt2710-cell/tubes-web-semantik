        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Namanya kini dipakai untuk museum dan Bandar Udara Palembang.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-mahmud-badaruddin-ii/image/3/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Tidak ada foto dibuat semasa hidupnya, sehingga potret disusun dari penggambaran kemudian.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-mahmud-badaruddin-ii/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Lukisan dan potret Sultan Mahmud Badaruddin II</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Potret serta lukisan pengasingan sultan ini menjadi koleksi utama museum. Sultan Mahmud Badaruddin II memimpin perlawanan terhadap Belanda dan dikenal karena menolak tunduk pada kekuasaan kolonial, sehingga namanya dipakai untuk museum ini dan juga Bandar Udara Palembang. Setelah dikalahkan, ia diasingkan ke Ternate dan meninggal di sana. Lukisan pengasingan penting karena memperlihatkan sisi lain dari seorang tokoh perang: kehidupan jauh dari negerinya sendiri.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa perlawanan terhadap Belanda, 1819–1821</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kesultanan Palembang Darussalam</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">lukisan dan foto arsip</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-mahmud-badaruddin-ii/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Tekstil dan pakaian tradisional</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang ini memuat kain, pakaian adat, dan kerajinan Sumatera Selatan. Palembang dikenal sebagai pusat kain songket, dan sebagian koleksi di sini menunjukkan bagaimana busana adat dipakai pada upacara kesultanan maupun pernikahan rakyat biasa. Perbedaan bahan menandai tingkat kemampuan pemakainya, misalnya antara sutra bermotif benang emas dan kain tenun sederhana. Dengan memajang keduanya, museum memperlihatkan bahwa busana tradisional tidak tunggal, melainkan berlapis menurut kedudukan sosial.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-19 hingga ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Sumatera Selatan</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kain tenun dan sulaman</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-mahmud-badaruddin-ii/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Koleksi senjata dan koin</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Senjata tradisional serta mata uang lama di ruang ini menunjukkan aktivitas perdagangan Palembang. Sungai Musi menjadi jalur utama yang menghubungkan pedalaman dengan pesisir, sehingga koin asing bisa sampai ke kawasan ini. Senjata mengingatkan bahwa Palembang pernah menjadi kota yang diperebutkan, termasuk dalam pertempuran melawan Belanda pada awal abad ke-19. Bersama-sama, benda di ruang ini menjelaskan kota pelabuhan yang kaya sekaligus sering dilanda konflik.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa kesultanan</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Palembang dan jalur dagang Musi</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">logam dan kayu</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-mahmud-badaruddin-ii/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Taman arca Sriwijaya</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Halaman museum dipenuhi artefak masa Sriwijaya, antara lain patung Ganesha dan Buddha. Menempatkan arca di taman, bukan di dalam ruang tertutup, mengikuti kebiasaan museum arkeologi di Asia Tenggara dan memungkinkan benda berukuran besar dipajang. Sriwijaya berpusat di kawasan ini dan pengaruhnya meluas lewat perdagangan maritim. Karena banyak arca ditemukan dalam keadaan tidak lengkap, taman ini juga berfungsi sebagai tempat penyimpanan terbuka yang bisa diteliti.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa Sriwijaya</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Sumatera bagian selatan</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">batu</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-sultan-mahmud-badaruddin-ii/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikipedia: Museum Sultan Mahmud Badaruddin II</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://id.wikipedia.org/wiki/Museum_Sultan_Mahmud_Badaruddin_II</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya">
        <rdfs:label xml:lang="id">Museum Taman Purbakala Kerajaan Sriwijaya</rdfs:label>
        <sdp:description xml:lang="id">Situs bekas permukiman masa Sriwijaya yang dilengkapi museum terbuka. Pengunjung dapat melihat struktur bata kuno, temuan keramik, dan replika prasasti di lokasi aslinya.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/sumatera-selatan"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/palembang"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/6"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/arkeologi"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/pra-kolonial"/>
        <sdp:address xml:lang="id">Jl. Syakyakirti, Palembang</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-2.9589</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">104.7322</sdp:longitude>
        <sdp:history xml:lang="id">Taman Purbakala Kerajaan Sriwijaya di Palembang adalah situs bekas permukiman masa Sriwijaya yang dilengkapi museum terbuka dan pendopo utama berarsitektur Limasan.

Kawasan ini menampilkan struktur bata kuno, temuan arkeologis, dan replika yang membantu menjelaskan kehidupan masyarakat Sriwijaya di tepi Sungai Musi.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/2"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/exhibit/3"/>
