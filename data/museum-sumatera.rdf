    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Museum Sriwijaya</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Bangunan museum ini berdiri di dalam taman yang memuat temuan dan penjelasan situs. Kawasan Karanganyar dipercaya sebagai salah satu pusat permukiman masa Sriwijaya, dan penelitian arkeologi di sini menemukan sisa bangunan serta benda dari masa itu. Museum sengaja dibangun dekat situs agar pengunjung bisa melihat temuan dan lokasi asalnya dalam satu kunjungan. Karena itu koleksinya berbeda dari museum umum: isinya berpusat pada satu kawasan dan satu masa.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">situs masa Sriwijaya</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kawasan Karanganyar, tepi Sungai Musi</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">bangunan modern di atas situs</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Pendopo utama Limasan</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Pendopo beratap limasan ini menjadi pusat kegiatan di taman purbakala. Bentuk limasan dipilih karena lazim dipakai pada bangunan pertemuan di Sumatera Selatan. Fungsinya bukan untuk memamerkan benda, melainkan untuk kegiatan seperti ceramah, pertunjukan, dan penerimaan tamu. Kehadirannya membuat taman purbakala tidak hanya menjadi tempat melihat reruntuhan, tetapi juga ruang yang dipakai masyarakat sampai sekarang.</sdp:exhibitDescription>
        <sdp:exhibitOrigin xml:lang="id">Taman purbakala</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kayu dan atap limasan</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Struktur bata kuno</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Sisa bangunan dari masa Sriwijaya ini dapat dilihat langsung di area situs. Struktur bata menunjukkan bahwa kawasan ini pernah memiliki bangunan permanen, kemungkinan tempat ibadah atau bangunan keagamaan. Berbeda dari benda yang dipajang di lemari kaca, struktur ini tidak dapat dipindahkan, sehingga dilestarikan di tempatnya. Bagi pengunjung, melihatnya langsung memberi pemahaman tentang skala dan tata letak kawasan yang jauh lebih baik daripada melihat foto.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa Sriwijaya</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Situs Karanganyar</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">bata</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Arca Buddha dari masa Sriwijaya</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Arca Buddha ini menjadi salah satu temuan yang paling sering ditampilkan dari kawasan situs. Sriwijaya dikenal sebagai pusat pembelajaran Buddhisme, dan catatan dari Tiongkok menyebut adanya hubungan antara kawasan ini dengan pusat pendidikan agama di India. Arca semacam ini menjadi bukti bahwa pengaruh Buddha tidak hanya ada di istana, tetapi menyebar ke permukiman. Bentuk dan gaya pahatannya membantu menentukan masa pembuatannya.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa Sriwijaya</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kawasan situs Karanganyar</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">batu</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikimedia Commons: Taman Purbakala Kerajaan Sriwijaya</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://commons.wikimedia.org/wiki/File:Taman_Purbakala_Kerajaan_Sriwijaya_-_Museum_Sriwijaya.jpg</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-timah-indonesia">
        <rdfs:label xml:lang="id">Museum Timah Indonesia</rdfs:label>
        <sdp:description xml:lang="id">Museum yang mengisahkan sejarah penambangan timah di Bangka Belitung sejak masa kolonial. Koleksinya mencakup peralatan tambang, mineral, dan diorama tambang terbuka.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/bangka-belitung"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/pangkalpinang"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/6"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/sains-teknologi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/sejarah-alam"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kemerdekaan"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1997</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Jenderal Ahmad Yani, Pangkalpinang</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-2.1316</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">106.1169</sdp:longitude>
        <sdp:history xml:lang="id">Museum Timah Indonesia di Pangkalpinang, Bangka Belitung, mengisahkan sejarah penambangan timah di Pulau Bangka sejak masa kolonial. Pada 1915 pemerintah Hindia Belanda membangun kantor penambangan timah di Muntok yang juga menjadi pusat pemerintahan Belanda di Bangka; gedung itu kemudian diambil alih tentara Jepang dan sempat terbengkalai setelah kemerdekaan.

PT Timah Tbk lalu melakukan konservasi bangunan bersejarah tersebut. Museum Timah Indonesia Muntok diresmikan pada 7 November 2013, sedangkan museum di Pangkalpinang menjadi rujukan koleksi pertimahan di ibu kota provinsi.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/1"/>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-timah-indonesia/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-timah-indonesia/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-timah-indonesia/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-timah-indonesia/exhibit/4"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-timah-indonesia/source/1"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-timah-indonesia/source/2"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#StateMuseum"/>
        <sdp:hasCollection rdf:resource="https://museumsumatera.id/resource/museum/museum-timah-indonesia/collection/1"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-timah-indonesia/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-timah-indonesia/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Museum Timah Pangkalpinang</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Gedung bergaya kolonial ini menjadi museum timah di Pangkalpinang, ibu kota Bangka Belitung. Timah adalah komoditas yang membentuk wajah pulau ini sejak masa Hindia Belanda, sehingga museumnya menyimpan peralatan tambang, foto, dan maket pertambangan.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">bangunan masa kolonial</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Timah Indonesia — foto dari Wikimedia Commons</sdp:imageAlt>
        <sdp:imageCaption xml:lang="id">Museum Timah (Tin Museum) of Pangkalpinang, Bangka Island.</sdp:imageCaption>
        <sdp:imageCredit xml:lang="id">Cun Cun</sdp:imageCredit>
