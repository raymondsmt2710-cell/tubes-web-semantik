        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Patung ini menggambarkan Tuanku Imam Bonjol sebagai pemimpin Perang Padri.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/image/2/detail/2">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Tidak ada potret dibuat semasa hidupnya, sehingga wajahnya disusun dari deskripsi.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/image/2/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Patung semacam ini menjadi penanda tempat dan dipakai sebagai latar kunjungan.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/image/2/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Ia diasingkan ke Cianjur lalu ke Lotta, Sulawesi Utara, dan meninggal pada 1864.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/image/3">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-tuanku-imam-bonjol/3.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Halaman dan bangunan museum</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Dari sisi lain terlihat proporsi bangunan 42 × 16,50 meter dengan gonjong di kedua ujungnya. Sejak 1998 museum ini dikelola Pemerintah Kabupaten Pasaman, dan sebagian koleksinya berupa replika karena benda asli Tuanku Imam Bonjol banyak yang hilang atau dicuri.</sdp:imageBackground>
        <sdp:imageAlt xml:lang="id">Museum Tuanku Imam Bonjol — foto dari Wikimedia Commons</sdp:imageAlt>
