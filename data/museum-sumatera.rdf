    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-lampung">
        <rdfs:label xml:lang="id">Museum Negeri Lampung Ruwa Jurai</rdfs:label>
        <sdp:description xml:lang="id">Museum provinsi Lampung dengan koleksi budaya Saibatin dan Pepadun, termasuk kain tapis dan replika rumah adat. Bangunannya menjadi rujukan pembelajaran sejarah lokal.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/lampung"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/bandar-lampung"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/7"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/seni-budaya"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kemerdekaan"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1988</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Dr. Ryacudu, Bandar Lampung</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-5.3819</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">105.2592</sdp:longitude>
        <sdp:history xml:lang="id">Museum Negeri Lampung Ruwa Jurai di Bandar Lampung adalah museum provinsi yang menyimpan warisan budaya masyarakat Lampung, baik dari kelompok Saibatin di pesisir maupun Pepadun di pedalaman.

Nama “Ruwa Jurai” merujuk dua golongan adat Lampung tersebut, dan koleksinya mencakup pakaian adat, tenun, serta benda upacara.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-lampung/image/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-lampung/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-lampung/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-lampung/exhibit/3"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-negeri-lampung/source/1"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-lampung/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-lampung/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-negeri-lampung/1.jpg</sdp:imageUrl>
