    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/image/3/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Dari halaman ini pengunjung biasanya melanjutkan ke makam Tuanku Imam Bonjol.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Senjata Perang Padri</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang ini memuat senjata yang dipakai Tuanku Imam Bonjol dan kaum Padri, sebagian berupa replika karena benda asli hilang atau dicuri. Perang Padri berlangsung puluhan tahun dan mula-mula merupakan konflik antarumat di Minangkabau sebelum Belanda ikut campur. Karena itu senjata di ruang ini tidak hanya berbicara tentang pertempuran melawan Belanda, tetapi juga tentang perang saudara yang mendahuluinya. Keterangan soal mana yang asli dan mana yang replika menjadi penting agar pengunjung tidak salah memahami benda yang dilihatnya.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">1803–1838</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Perang Padri, Minangkabau</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">logam dan kayu; sebagian replika</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Lukisan Tuanku Imam Bonjol</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Lukisan ini dibuat oleh Jenderal Hoegeng Imam Santoso, Kepala Polisi Republik Indonesia pada 1968–1971. Menariknya, pelukisnya adalah pejabat negara, bukan seniman yang dikenal khusus melukis tokoh sejarah. Karena tidak ada potret dibuat semasa hidup Tuanku Imam Bonjol, wajahnya di banyak penggambaran disusun dari deskripsi dan bayangan seniman. Lukisan seperti ini menunjukkan bagaimana tokoh sejarah dibentuk kembali citranya oleh generasi sesudahnya, termasuk lewat karya pejabat negara.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Karya Jenderal Hoegeng Imam Santoso</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">lukisan</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Pakaian kebesaran ulama</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Kostum kebesaran ini pernah dipakai Tuanku Imam Bonjol dan tokoh lain pada masanya. Pakaian ulama pada masa Perang Padri menandai kedudukan sebagai pemimpin agama sekaligus pemimpin masyarakat, karena kedua peran itu tidak dipisahkan. Warna dan potongannya berbeda dari pakaian adat sehari-hari, sehingga bisa dikenali dalam penggambaran sejarah. Bagi pengunjung, busana ini membantu membayangkan sosok yang selama ini dikenal lewat lukisan dan cerita perang.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">awal abad ke-19</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Tuanku Imam Bonjol dan tokoh sezamannya</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kain dan aksesori</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Lantai dua: perkakas dan uang kuno</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Lantai dua memuat peralatan dapur, uang kuno, keramik antik, serta gamelan dan gong berbagai ukuran. Peralatan dapur dan keramik menggambarkan rumah tangga Minangkabau, sedangkan uang kuno menunjukkan bahwa kawasan ini terhubung dengan perdagangan lintas wilayah. Gamelan di Minangkabau menarik diperhatikan karena kesenian ini lebih sering dikaitkan dengan Jawa dan Bali, sehingga kehadirannya menunjukkan percampuran budaya. Bersama-sama, benda di lantai ini melengkapi kisah perang dengan gambaran kehidupan sehari-hari.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">abad ke-18 hingga ke-20</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Minangkabau dan jalur dagang pesisir</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">logam, keramik, dan perunggu</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/exhibit/5">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Naskah kuno dan replika</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Ruang ini memuat sejumlah naskah lama, dan sebagian telah hilang sehingga digantikan replika oleh pengelola. Naskah pada masa Perang Padri biasanya berisi ajaran keagamaan, catatan peristiwa, atau surat menyurat antarpemimpin. Kehilangan naskah adalah masalah serius bagi penelitian sejarah karena isinya tidak bisa digantikan. Karena itu museum mencantumkan mana yang asli dan mana yang replika, supaya pengunjung dan peneliti tidak salah menyimpulkan.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa Perang Padri</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Minangkabau</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kertas dan kulit; sebagian replika</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-tuanku-imam-bonjol/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikipedia: Museum Tuanku Imam Bonjol</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://id.wikipedia.org/wiki/Museum_Tuanku_Imam_Bonjol</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto">
        <rdfs:label xml:lang="id">Museum Kereta Api Sawahlunto</rdfs:label>
        <sdp:description xml:lang="id">Mengisi bekas stasiun dan depo lokomotif yang menghubungkan tambang batu bara Ombilin dengan pelabuhan. Koleksinya berupa lokomotif uap, gerbong, dan peralatan kereta peninggalan kolonial.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/sumatera-barat"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/sawahlunto"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/4"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/sains-teknologi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/sejarah-alam"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kolonial"/>
        <sdp:address xml:lang="id">Jl. Raya Sawahlunto, Sawahlunto</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-0.6811</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.7744</sdp:longitude>
        <sdp:history xml:lang="id">Museum Kereta Api Sawahlunto menempati Stasiun Sawahlunto, stasiun kelas II di Lembah Segar yang dikelola Divisi Regional II Sumatera Barat bersama Pemerintah Kota Sawahlunto. Stasiun ini berhenti beroperasi pada 2003 setelah tambang batu bara habis, lalu dijadikan museum pada 2005.

Museum ini adalah museum perkeretaapian kedua di Indonesia setelah Ambarawa. Stasiunnya memiliki lima jalur kereta, dan lokasinya berada pada ketinggian sekitar +261 meter.</sdp:history>
        <sdp:hasImage rdf:resource="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/image/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/exhibit/1"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/exhibit/2"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/exhibit/3"/>
        <sdp:hasExhibit rdf:resource="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/exhibit/4"/>
        <sdp:hasSource rdf:resource="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/source/1"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#SiteMuseum"/>
        <rdf:type rdf:resource="https://museumsumatera.id/ontology#StateMuseum"/>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-kereta-api-sawahlunto/1.jpg</sdp:imageUrl>
        <sdp:verificationStatus>perlu-verifikasi</sdp:verificationStatus>
    </sdp:Museum>

    <sdp:Image rdf:about="https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/image/1">
        <sdp:imageIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:imageIndex>
        <sdp:imageUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">/images/museums/museum-kereta-api-sawahlunto/1.jpg</sdp:imageUrl>
        <sdp:imageTitle xml:lang="id">Stasiun Sawahlunto dan lokomotif</sdp:imageTitle>
        <sdp:imageBackground xml:lang="id">Foto ini memperlihatkan peron beratap dengan papan nama SAWAHLUNTO, lokomotif uap kecil di jalur, gerbong ketel biru, dan roda kereta yang diletakkan di tanah berbatu. Stasiun ini berhenti beroperasi pada 2003 setelah tambang batu bara habis, lalu dijadikan museum pada 2005 — museum perkeretaapian kedua di Indonesia setelah Ambarawa.</sdp:imageBackground>
        <sdp:imagePeriod xml:lang="id">akhir abad ke-19</sdp:imagePeriod>
        <sdp:imageAlt xml:lang="id">Museum Kereta Api Sawahlunto — foto dari Wikimedia Commons</sdp:imageAlt>
