        <sdp:detailText xml:lang="id">Gedung ini adalah Museum Negeri Sumatera Selatan di kawasan Sekayu, Palembang.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-negeri-sumatera-selatan/image/1/detail/2">
