    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-daerah-deli-serdang/image/3/detail/3">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Penempatannya di ruang pamer menunjukkan museum juga mendokumentasikan pemerintahan, bukan hanya benda lama.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:ImageDetail rdf:about="https://museumsumatera.id/resource/museum/museum-daerah-deli-serdang/image/3/detail/4">
        <sdp:detailIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:detailIndex>
        <sdp:detailText xml:lang="id">Bagi pengunjung lokal, panel ini biasanya menjadi tempat mencari nama kampungnya sendiri.</sdp:detailText>
    </sdp:ImageDetail>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-daerah-deli-serdang/exhibit/1">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Lantai 1: prasejarah dan kesultanan</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Lantai pertama memuat sejarah Deli Serdang, Kesultanan Deli, dan Kesultanan Serdang, termasuk kisah perjuangan di Deli Serdang. Alurnya disusun dari masa prasejarah menuju berdirinya kesultanan, sehingga pengunjung memahami bahwa dua kesultanan itu muncul dalam lanskap yang sudah lama dihuni. Letak Deli Serdang yang dekat dengan pelabuhan membuat kawasan ini tumbuh cepat pada masa kolonial. Karena itu lantai ini menjadi dasar sebelum pengunjung naik ke koleksi kesultanan di lantai berikutnya.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">prasejarah hingga Kesultanan Deli dan Serdang</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Lantai satu gedung museum</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">panel, replika, dan benda koleksi</sdp:exhibitMaterial>
        <sdp:exhibitHighlight rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sdp:exhibitHighlight>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-daerah-deli-serdang/exhibit/2">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Kisah Putri Hijau</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Kisah Putri Hijau dipaparkan di tangga antara lantai satu dan dua. Legenda ini dikenal luas dalam tradisi Melayu dan dikaitkan dengan asal-usul Kesultanan Deli, sehingga berfungsi sebagai penghubung antara bagian prasejarah dan bagian kesultanan. Menempatkannya di tangga adalah pilihan tata pamer yang menarik: pengunjung membaca kisah sambil berpindah lantai, seperti berpindah dari mitos ke sejarah. Karena berupa legenda, isinya tidak dipakai sebagai bukti sejarah, melainkan sebagai cara masyarakat mengingat asal-usulnya.</sdp:exhibitDescription>
        <sdp:exhibitOrigin xml:lang="id">Tradisi lisan Deli dan Serdang</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">panel naratif</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-daerah-deli-serdang/exhibit/3">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Lantai 2: koleksi Kesultanan Serdang</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Lantai dua memuat pakaian, alat musik, perlengkapan rumah tangga, hingga prasasti dari masa kesultanan. Koleksi semacam ini memperlihatkan kehidupan istana dari sisi yang jarang dibayangkan: bukan hanya upacara besar, tetapi juga peralatan sehari-hari dan cara orang berpakaian. Alat musik menunjukkan bahwa kesultanan menjadi pusat kegiatan seni, sementara prasasti memberi bukti tertulis tentang pemerintahan. Bersama-sama, benda di lantai ini menggambarkan kesultanan sebagai pusat kebudayaan, bukan hanya kekuasaan.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">masa Kesultanan Serdang</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Kesultanan Serdang</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">kain, alat musik, perlengkapan rumah tangga, prasasti</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Exhibit rdf:about="https://museumsumatera.id/resource/museum/museum-daerah-deli-serdang/exhibit/4">
        <sdp:exhibitIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</sdp:exhibitIndex>
        <sdp:exhibitTitle xml:lang="id">Lantai 3: pasca kemerdekaan</sdp:exhibitTitle>
        <sdp:exhibitDescription xml:lang="id">Lantai tiga memuat koleksi yang mengingatkan masa-masa setelah Indonesia merdeka. Bagian ini melengkapi dua lantai sebelumnya dengan menunjukkan apa yang berubah setelah kesultanan tidak lagi berkuasa. Bagi Deli Serdang, masa itu ditandai oleh peralihan pemerintahan, perubahan tata guna tanah, dan pertumbuhan kota di sekitar Medan. Dengan menutup alur di lantai ini, museum menyusun perjalanan dari masa prasejarah sampai pemerintahan republik dalam satu bangunan.</sdp:exhibitDescription>
        <sdp:exhibitPeriod xml:lang="id">setelah 1945</sdp:exhibitPeriod>
        <sdp:exhibitOrigin xml:lang="id">Masa kemerdekaan Indonesia</sdp:exhibitOrigin>
        <sdp:exhibitMaterial xml:lang="id">dokumen, foto, dan benda koleksi</sdp:exhibitMaterial>
    </sdp:Exhibit>

    <sdp:Source rdf:about="https://museumsumatera.id/resource/museum/museum-daerah-deli-serdang/source/1">
        <sdp:sourceIndex rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sdp:sourceIndex>
        <sdp:sourceLabel xml:lang="id">Wikipedia: Museum Deli Serdang</sdp:sourceLabel>
        <sdp:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://id.wikipedia.org/wiki/Museum_Deli_Serdang</sdp:sourceUrl>
    </sdp:Source>

    <sdp:Collection rdf:about="https://museumsumatera.id/resource/museum/museum-daerah-deli-serdang/collection/1">
        <sdp:collectionCategory xml:lang="id">etnografi</sdp:collectionCategory>
    </sdp:Collection>

    <sdp:Museum rdf:about="https://museumsumatera.id/resource/museum/museum-sang-nila-utama">
        <rdfs:label xml:lang="id">Museum Sang Nila Utama</rdfs:label>
        <sdp:description xml:lang="id">Museum negeri Riau dengan arsitektur berlambang rumah adat Melayu. Koleksinya mencakup tenun songket, perahu tradisional, dan benda upacara masyarakat Melayu pesisir.</sdp:description>
        <sdp:locatedInProvince rdf:resource="https://museumsumatera.id/resource/province/riau"/>
        <sdp:locatedInCity rdf:resource="https://museumsumatera.id/resource/city/pekanbaru"/>
        <sdp:chapter rdf:resource="https://museumsumatera.id/resource/chapter/3"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/etnografi"/>
        <sdp:hasTheme rdf:resource="https://museumsumatera.id/resource/theme/seni-budaya"/>
        <sdp:hasEra rdf:resource="https://museumsumatera.id/resource/era/kemerdekaan"/>
        <sdp:establishedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1976</sdp:establishedYear>
        <sdp:address xml:lang="id">Jl. Jenderal Sudirman No. 194, Pekanbaru</sdp:address>
        <sdp:latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5071</sdp:latitude>
        <sdp:longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">101.4478</sdp:longitude>
        <sdp:history xml:lang="id">Museum Sang Nila Utama berada di Jalan Jenderal Sudirman, Pekanbaru, dalam satu kompleks dengan kantor Dinas Kebudayaan Provinsi Riau. Museum ini dahulu bernama Museum Negeri Provinsi Riau dan didirikan pada 9 Januari 1991 melalui Surat Keputusan Menteri Pendidikan dan Kebudayaan Nomor 001/0/1991.

Setelah kewenangan bidang pemerintahan dialihkan ke daerah lewat Undang-Undang Nomor 22 Tahun 1999, museum ini berubah menjadi museum daerah di bawah Dinas Kebudayaan, Kesenian dan Pariwisata Provinsi Riau. Nama Sang Nila Utama mulai dipakai atas inisiatif kepala museum melalui Surat Keputusan Nomor 227/109.09/MR/C-93 pada 13 Oktober 1993, merujuk raja Bintan yang berkuasa sekitar abad ke-13.</sdp:history>
