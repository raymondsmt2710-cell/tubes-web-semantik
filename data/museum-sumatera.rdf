    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#imageUrl">
        <rdfs:label xml:lang="id">tautan gambar</rdfs:label>
        <rdfs:domain rdf:resource="https://museumsumatera.id/ontology#Museum"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://museumsumatera.id/ontology#officialUrl">
