        <https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/2/detail/4> ;
    sdp:imageIndex 2 ;
    sdp:imageLicense "CC BY-SA 4.0"@id ;
    sdp:imageLicenseUrl "https://creativecommons.org/licenses/by-sa/4.0"^^xsd:anyURI ;
    sdp:imagePeriod "1938–1942"@id ;
    sdp:imageSource "https://commons.wikimedia.org/wiki/File%3ARumah_Pengasingan_Bung_Karno.jpg"^^xsd:anyURI ;
    sdp:imageTitle "Halaman dan rumah pengasingan"@id ;
    sdp:imageUrl "/images/museums/rumah-pengasingan-bung-karno/2.jpg"^^xsd:anyURI .

<https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/2/detail/1> a sdp:ImageDetail ;
    sdp:detailIndex 1 ;
    sdp:detailText "Halaman ini adalah bagian dari rumah pengasingan Soekarno di Bengkulu."@id .

<https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/2/detail/2> a sdp:ImageDetail ;
    sdp:detailIndex 2 ;
    sdp:detailText "Bangunannya sederhana, menunjukkan kehidupan yang terbatas semasa pengasingan."@id .

<https://museumsumatera.id/resource/museum/rumah-pengasingan-bung-karno/image/2/detail/3> a sdp:ImageDetail ;
    sdp:detailIndex 3 ;
    sdp:detailText "Soekarno diasingkan ke sini pada 1938 dan tinggal sampai 1942."@id .

