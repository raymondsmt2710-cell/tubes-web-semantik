        <https://museumsumatera.id/resource/museum/museum-negeri-sumatera-utara/image/1/detail/4> ;
    sdp:imageIndex 1 ;
    sdp:imageLicense "CC BY-SA 4.0"@id ;
    sdp:imageLicenseUrl "https://creativecommons.org/licenses/by-sa/4.0"^^xsd:anyURI ;
    sdp:imagePeriod "diresmikan 1982"@id ;
    sdp:imageSource "https://commons.wikimedia.org/wiki/File%3AMuseum_Negeri_Sumatera_Utara_Medan.jpg"^^xsd:anyURI ;
    sdp:imageTitle "Gedung induk museum"@id ;
    sdp:imageUrl "/images/museums/museum-negeri-sumatera-utara/1.jpg"^^xsd:anyURI .

