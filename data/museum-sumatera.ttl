    sdp:imagePeriod "arsitektur rumah kolonial"@id ;
    sdp:imageSource "https://commons.wikimedia.org/wiki/File%3ARumah_Bung_Karno_di_Bengkulu.jpg"^^xsd:anyURI ;
    sdp:imageTitle "Rumah pengasingan dari sisi jalan"@id ;
    sdp:imageUrl "/images/museums/rumah-pengasingan-bung-karno/3.jpg"^^xsd:anyURI .

