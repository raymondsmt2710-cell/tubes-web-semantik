        <https://museumsumatera.id/resource/museum/museum-tb-silalahi-center/image/3/detail/4> ;
    sdp:imageIndex 3 ;
    sdp:imageLicense "CC BY-SA 4.0"@id ;
    sdp:imageLicenseUrl "https://creativecommons.org/licenses/by-sa/4.0"^^xsd:anyURI ;
    sdp:imageSource "https://commons.wikimedia.org/wiki/File%3ANatural_scenery_around_T.B._Silalahi_Center.jpg"^^xsd:anyURI ;
    sdp:imageTitle "Lanskap sekitar museum"@id ;
    sdp:imageUrl "/images/museums/museum-tb-silalahi-center/3.jpg"^^xsd:anyURI .

