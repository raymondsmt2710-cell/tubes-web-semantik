<https://museumsumatera.id/resource/museum/museum-adityawarman/image/2/detail/2> a sdp:ImageDetail ;
    sdp:detailIndex 2 ;
    sdp:detailText "Atap melengkung seperti tanduk kerbau adalah ciri yang membedakannya dari rumah adat lain."@id .

<https://museumsumatera.id/resource/museum/museum-adityawarman/image/2/detail/3> a sdp:ImageDetail ;
