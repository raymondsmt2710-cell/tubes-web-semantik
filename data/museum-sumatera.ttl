<https://museumsumatera.id/resource/museum/museum-linggam-cahaya> a sdp:SiteMuseum ;
    sdp:address "Daik, Kabupaten Lingga"@id ;
    sdp:chapter <https://museumsumatera.id/resource/chapter/3> ;
    sdp:description "Museum daerah di bekas pusat Kesultanan Lingga yang menyimpan koleksi kerajaan Melayu, termasuk naskah, alat musik, dan peninggalan masa kejayaan Lingga."@id ;
    sdp:hasEra <https://museumsumatera.id/resource/era/kolonial> ;
    sdp:hasExhibit <https://museumsumatera.id/resource/museum/museum-linggam-cahaya/exhibit/1>,
