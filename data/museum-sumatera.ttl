<https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto> a sdp:SiteMuseum,
        sdp:StateMuseum ;
    sdp:address "Jl. Raya Sawahlunto, Sawahlunto"@id ;
    sdp:chapter <https://museumsumatera.id/resource/chapter/4> ;
    sdp:description "Mengisi bekas stasiun dan depo lokomotif yang menghubungkan tambang batu bara Ombilin dengan pelabuhan. Koleksinya berupa lokomotif uap, gerbong, dan peralatan kereta peninggalan kolonial."@id ;
