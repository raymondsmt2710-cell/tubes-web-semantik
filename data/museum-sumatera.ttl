    sdp:imageIndex 3 ;
    sdp:imageLicense "Public domain"@id ;
    sdp:imagePeriod "abad ke-19"@id ;
    sdp:imageSource "https://commons.wikimedia.org/wiki/File:Masjid_Jami_Sultan_Lingga_pintu.jpg"^^xsd:anyURI ;
    sdp:imageTitle "Pintu berukir masjid"@id ;
