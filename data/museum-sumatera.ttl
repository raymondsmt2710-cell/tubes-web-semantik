    sdp:imageSource "https://commons.wikimedia.org/wiki/File%3ATextile_Museum_of_South_Sumatra_-_Bukit_Kecil%2C_Palembang%2C_SS.jpg"^^xsd:anyURI ;
    sdp:imageTitle "Bangunan museum dan halaman"@id ;
    sdp:imageUrl "/images/museums/museum-negeri-sumatera-selatan/1.jpg"^^xsd:anyURI .

