    sdp:imagePeriod "lanskap Danau Toba masa kolonial"@id ;
    sdp:imageSource "https://commons.wikimedia.org/wiki/File:Bakkara_Village,_North_Sumatra,_Indonesia.jpg"^^xsd:anyURI ;
    sdp:imageTitle "Lembah Bakkara dari atas"@id ;
    sdp:imageUrl "/images/museums/museum-sisingamangaraja-xii/1.jpg"^^xsd:anyURI .

