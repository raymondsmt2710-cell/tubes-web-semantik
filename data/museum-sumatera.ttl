<https://museumsumatera.id/resource/museum/museum-timah-indonesia> a sdp:StateMuseum ;
    sdp:address "Jl. Jenderal Ahmad Yani, Pangkalpinang"@id ;
    sdp:chapter <https://museumsumatera.id/resource/chapter/6> ;
    sdp:description "Museum yang mengisahkan sejarah penambangan timah di Bangka Belitung sejak masa kolonial. Koleksinya mencakup peralatan tambang, mineral, dan diorama tambang terbuka."@id ;
    sdp:establishedYear "1997"^^xsd:gYear ;
    sdp:hasCollection <https://museumsumatera.id/resource/collection/museum-timah-indonesia/etnografi> ;
