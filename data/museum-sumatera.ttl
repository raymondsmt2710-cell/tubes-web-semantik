    sdp:detailText "Karena berada di area situs, strukturnya tetap di tempat aslinya."@id .

<https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/image/2> a sdp:Image ;
    sdp:imageAlt "Museum Purbakala Pugung Raharjo — foto dari Wikimedia Commons"@id ;
    sdp:imageBackground "Dari permukaan, struktur tadi tampak sebagai gundukan berundak yang dikelilingi kebun kelapa dan pematang. Situs ini juga dikaitkan dengan benteng tanah dan arca megalitik, sehingga menjadi salah satu rujukan utama untuk memahami masa prasejarah di Lampung."@id ;
    sdp:imageCaption "Prehistoric remains include perforated stones, etched stones, stone mortars, menhirs, terraced altars, and megalithic pools. In the center of the site is the Batu Kandang, locally"@id ;
    sdp:imageCredit "Hilman.wu"@id ;
    sdp:imageDetail <https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/image/2/detail/1>,
        <https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/image/2/detail/2>,
        <https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/image/2/detail/3>,
        <https://museumsumatera.id/resource/museum/museum-purbakala-pugung-raharjo/image/2/detail/4> ;
    sdp:imageIndex 2 ;
    sdp:imageLicense "CC BY-SA 4.0"@id ;
    sdp:imageLicenseUrl "https://creativecommons.org/licenses/by-sa/4.0"^^xsd:anyURI ;
    sdp:imagePeriod "masa megalitik"@id ;
    sdp:imageSource "https://commons.wikimedia.org/wiki/File%3APugung_Raharjo.jpg"^^xsd:anyURI ;
    sdp:imageTitle "Gundukan berundak di tengah perkebunan"@id ;
    sdp:imageUrl "/images/museums/museum-purbakala-pugung-raharjo/2.jpg"^^xsd:anyURI .

