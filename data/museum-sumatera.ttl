    sdp:imageAlt "Museum Taman Purbakala Kerajaan Sriwijaya — foto dari Wikimedia Commons"@id ;
    sdp:imageBackground "Arca Buddha yang sudah rusak ini ditemukan di kawasan Sriwijaya dan kini dipajang di halaman salah satu museum Palembang. Temuan arca menjadi bukti bahwa Sriwijaya adalah pusat kajian agama Buddha yang penting: banyak pelajar dari Cina dan India datang ke sini untuk menyalin kitab."@id ;
    sdp:imageCaption "A fragmented Buddha statue was displayed at the yard of Sultan Mahmud Badaruddin II Museum in Palembang, then moved to Taman Purbakala Kerajaan Sriwijaya. The statue was discovered"@id ;
    sdp:imageCredit "Gunawan Kartapranata. Anon"@id ;
    sdp:imageDetail <https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/3/detail/1>,
        <https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/3/detail/2>,
        <https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/3/detail/3>,
        <https://museumsumatera.id/resource/museum/museum-taman-purbakala-sriwijaya/image/3/detail/4> ;
    sdp:imageIndex 3 ;
    sdp:imageLicense "CC BY-SA 4.0"@id ;
    sdp:imageLicenseUrl "https://creativecommons.org/licenses/by-sa/4.0"^^xsd:anyURI ;
    sdp:imagePeriod "masa Sriwijaya"@id ;
    sdp:imageSource "https://commons.wikimedia.org/wiki/File%3ABuddha_Seguntang_Palembang_(grayscale).jpg"^^xsd:anyURI ;
    sdp:imageTitle "Arca Buddha dari masa Sriwijaya"@id ;
    sdp:imageUrl "/images/museums/museum-taman-purbakala-sriwijaya/3.jpg"^^xsd:anyURI .

