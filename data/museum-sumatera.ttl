        <https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/image/3/detail/3>,
        <https://museumsumatera.id/resource/museum/museum-kereta-api-sawahlunto/image/3/detail/4> ;
    sdp:imageIndex 3 ;
    sdp:imageLicense "Public domain"@id ;
    sdp:imagePeriod "stasiun era kolonial, +262 m"@id ;
    sdp:imageSource "https://commons.wikimedia.org/wiki/File:MUSEUM-KERETA-API-2019.jpg"^^xsd:anyURI ;
    sdp:imageTitle "Peron Stasiun Sawahlunto"@id ;
    sdp:imageUrl "/images/museums/museum-kereta-api-sawahlunto/3.jpg"^^xsd:anyURI .

