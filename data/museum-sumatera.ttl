<https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/1/detail/3> a sdp:ImageDetail ;
    sdp:detailIndex 3 ;
    sdp:detailText "Uang lama disimpan museum sebagai koleksi numismatika."@id .

<https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/1/detail/4> a sdp:ImageDetail ;
    sdp:detailIndex 4 ;
    sdp:detailText "Koleksi seperti ini dipakai untuk menelusuri perubahan nilai dan desain uang."@id .

<https://museumsumatera.id/resource/museum/museum-negeri-bengkulu/image/2> a sdp:Image ;
