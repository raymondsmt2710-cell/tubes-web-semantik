        <https://museumsumatera.id/resource/museum/museum-negeri-jambi/image/2/detail/3>,
        <https://museumsumatera.id/resource/museum/museum-negeri-jambi/image/2/detail/4> ;
    sdp:imageIndex 2 ;
    sdp:imageLicense "Public domain"@id ;
    sdp:imagePeriod "gedung dibangun 1981, diresmikan 1988"@id ;
