<https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/2/detail/3> a sdp:ImageDetail ;
    sdp:detailIndex 3 ;
    sdp:detailText "Museum ini melengkapi koleksi serupa di Pangkalpinang."@id .

<https://museumsumatera.id/resource/museum/museum-timah-indonesia/image/2/detail/4> a sdp:ImageDetail ;
    sdp:detailIndex 4 ;
