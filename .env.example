# Endpoint SPARQL query (wajib). Sesuaikan nama dataset dengan milik Anda.
FUSEKI_ENDPOINT=http://localhost:3030/museum/query
# Endpoint Graph Store / update (opsional, hanya untuk skrip upload)
FUSEKI_UPDATE=http://localhost:3030/museum/data

# Adapter LLM (opsional). Kosongkan untuk memakai penerjemah aturan.
# Nilai yang didukung: openai, groq, gemini
LLM_PROVIDER=openai
# Jangan pernah commit kunci asli. Berkas .env sudah masuk .gitignore.
LLM_API_KEY=
# Kosongkan untuk memakai model bawaan penyedia.
LLM_MODEL=
